<div class="pager">
    <span>@(Total == 0 ? "Aucune ligne" : $"{(Query.SafePage - 1) * Query.SafePageSize + 1:N0}–{Math.Min(Query.SafePage * Query.SafePageSize, Total):N0} sur {Total:N0}")</span>
    <select aria-label="Lignes par page" value="@Query.PageSize" @onchange="SetSize">
        @foreach (var s in new[] { 10, 25, 50, 100 }) { <option value="@s">@s / page</option> }
    </select>
    <button class="btn sm" disabled="@(Query.SafePage <= 1)" @onclick="() => Go(Query.SafePage - 1)">‹ Préc.</button>
    <span>Page @Query.SafePage / @Math.Max(1, Pages)</span>
    <button class="btn sm" disabled="@(Query.SafePage >= Pages)" @onclick="() => Go(Query.SafePage + 1)">Suiv. ›</button>
</div>

@code {
    [Parameter, EditorRequired] public TableQuery Query { get; set; } = default!;
    [Parameter] public int Total { get; set; }
    [Parameter] public EventCallback OnChanged { get; set; }

    private int Pages => (int)Math.Ceiling(Total / (double)Query.SafePageSize);

    private async Task Go(int page) { Query.Page = page; await OnChanged.InvokeAsync(); }

    private async Task SetSize(ChangeEventArgs e)
    {
        Query.PageSize = int.TryParse(e.Value?.ToString(), out var s) ? s : 25;
        Query.Page = 1;
        await OnChanged.InvokeAsync();
    }
}
