@* Multi-select dropdown with search. Selecting a value applies immediately (server-side filtering). *@
<div class="fsel">
    <button type="button" class="@(Selected.Count > 0 ? "on" : "")" @onclick="Toggle" aria-expanded="@_open">
        @Label
        @if (Selected.Count == 1) { <span>: @LabelOf(Selected[0])</span> }
        else if (Selected.Count > 1) { <span class="count">@Selected.Count</span> }
        <span class="caret">▼</span>
    </button>
    @if (_open)
    {
        <div class="backdrop" @onclick="() => _open = false"></div>
        <div class="fpanel">
            @if (Options.Count > 8)
            {
                <input type="search" placeholder="Rechercher : @Label.ToLowerInvariant()…" @bind="_q" @bind:event="oninput" />
            }
            <div class="opts">
                @foreach (var group in Visible.GroupBy(o => o.Group))
                {
                    @if (group.Key is not null && Options.Select(o => o.Group).Distinct().Count() > 1) { <div class="grp">@group.Key</div> }
                    @foreach (var o in group)
                    {
                        <label>
                            <input type="checkbox" checked="@Selected.Contains(o.Value)" @onchange="() => Pick(o.Value)" />
                            @o.Label
                        </label>
                    }
                }
                @if (!Visible.Any()) { <div class="empty" style="padding:10px">Aucun résultat</div> }
            </div>
            <div class="actions">
                <button type="button" @onclick="Clear">Effacer</button>
                <button type="button" @onclick="() => _open = false">OK</button>
            </div>
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired] public string Label { get; set; } = "";
    [Parameter] public IReadOnlyList<Option> Options { get; set; } = [];
    [Parameter] public List<string> Selected { get; set; } = [];
    [Parameter] public EventCallback<List<string>> SelectedChanged { get; set; }

    private bool _open;
    private string _q = "";

    private IEnumerable<Option> Visible => string.IsNullOrWhiteSpace(_q)
        ? Options
        : Options.Where(o => o.Label.Contains(_q, StringComparison.OrdinalIgnoreCase) || o.Value.Contains(_q, StringComparison.OrdinalIgnoreCase));

    private string LabelOf(string v) => Options.FirstOrDefault(o => o.Value == v)?.Label ?? v;

    private void Toggle() { _open = !_open; _q = ""; }

    private async Task Pick(string value)
    {
        var next = Selected.ToList();
        if (!next.Remove(value)) next.Add(value);
        await SelectedChanged.InvokeAsync(next);
    }

    private async Task Clear() => await SelectedChanged.InvokeAsync([]);

}
