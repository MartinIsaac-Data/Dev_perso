@inject AuthSession Session

@if (Session.Can(Permission))
{
    @ChildContent
}
else
{
    <div class="card" style="max-width:560px;margin:40px auto">
        <div class="card-body" style="text-align:center;padding:36px">
            <div style="font-size:30px">⚿</div>
            <h2 style="margin:8px 0">Access restricted</h2>
            <p class="muted">Your role does not include <b>@Permission</b>. Ask an administrator if you need this view.</p>
            <a class="btn" href="">Back to the portal</a>
        </div>
    </div>
}

@code {
    [Parameter, EditorRequired] public string Permission { get; set; } = "";
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
