@page "/admin/audit"
@inject ApiClient Api

<PageTitle>Audit Log · Broli S&amp;OP</PageTitle>

<RequirePermission Permission="@Permissions.AuditView">
    <PageHeader Title="Audit Log" Question="Who changed what, and when?" />
    @if (_error is not null) { <div class="alert error">@_error</div> }
    <div class="card">
        <div class="table-tools">
            <input type="search" placeholder="Search user, action, object, value…" @bind="_search" @bind:event="oninput" @bind:after="Reload" />
            <select class="btn sm" @bind="_module" @bind:after="Reload" aria-label="Module">
                <option value="">All modules</option>
                @foreach (var m in new[] { "Security", "Supply", "Risks", "Data Management", "Configuration", "Administration", "Export" }) { <option>@m</option> }
            </select>
        </div>
        <div class="table-wrap">
            <table class="data">
                <thead><tr><th>Date</th><th>User</th><th>Action</th><th>Module</th><th>Object</th><th>Old value</th><th>New value</th></tr></thead>
                <tbody>
                    @foreach (var a in _page?.Items ?? [])
                    {
                        <tr><td class="nowrap">@Fmt.DateTime(a.TimestampUtc)</td><td>@a.Username</td><td>@a.Action</td><td>@a.Module</td><td>@a.ObjectRef</td>
                            <td class="muted" style="max-width:280px;overflow-wrap:anywhere">@a.OldValue</td><td style="max-width:280px;overflow-wrap:anywhere">@a.NewValue</td></tr>
                    }
                </tbody>
            </table>
            @if (_page is { Total: 0 }) { <div class="empty">No entry.</div> }
        </div>
        <div class="pager">
            <span>@(_page?.Total ?? 0) entries</span>
            <button class="btn sm" disabled="@(_p <= 1)" @onclick="() => Go(_p - 1)">‹ Prev</button>
            <span>Page @_p / @Math.Max(1, _page?.PageCount ?? 1)</span>
            <button class="btn sm" disabled="@(_p >= (_page?.PageCount ?? 1))" @onclick="() => Go(_p + 1)">Next ›</button>
        </div>
    </div>
</RequirePermission>

@code {
    private PagedResult<AuditEntryDto>? _page;
    private string _search = "", _module = "";
    private int _p = 1;
    private string? _error;

    protected override Task OnInitializedAsync() => Load();
    private Task Reload() { _p = 1; return Load(); }
    private Task Go(int p) { _p = p; return Load(); }

    private async Task Load()
    {
        try { _page = await Api.GetAsync<PagedResult<AuditEntryDto>>($"api/admin/audit?page={_p}&pageSize=50&search={Uri.EscapeDataString(_search)}&module={Uri.EscapeDataString(_module)}"); }
        catch (ApiException ex) { _error = ex.Full; }
    }
}
