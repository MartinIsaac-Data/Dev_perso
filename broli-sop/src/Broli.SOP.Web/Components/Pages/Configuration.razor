@page "/admin/config"
@inject ApiClient Api
@inject AuthSession Session

<PageTitle>Configuration · Broli S&amp;OP</PageTitle>

<RequirePermission Permission="@Permissions.ConfigEdit">
    <PageHeader Title="Configuration" Question="Which business rules drive coverage, risks and KPIs?">
        <Actions><button class="btn primary" @onclick="Save" disabled="@(_s is null || _saving)">Save configuration</button></Actions>
    </PageHeader>
    @if (_error is not null) { <div class="alert error" role="alert">✖ <div>@_error</div></div> }
    @if (_ok) { <div class="alert ok">✔ Saved. All dashboards are recalculated with the new parameters; the change is in the audit log.</div> }

    @if (_s is { } s)
    {
        <div class="grid g-2">
            <div class="card" style="grid-column:1 / -1">
                <div class="card-head"><h2>Alerts &amp; notifications</h2>
                    <button class="btn sm" @onclick="RunAlerts" disabled="@_saving">Run alerts now</button></div>
                <div class="card-body form">
                    @{ var a = s.Alerts!; }
                    <div class="field"><label class="check"><input type="checkbox" @bind="a.StockoutRisk" /> Stockout risk detected (Critical coverage) → Inventory viewers</label></div>
                    <div class="field"><label class="check"><input type="checkbox" @bind="a.CoverageBelowThreshold" /> Coverage below the Risk threshold → Inventory viewers</label></div>
                    <div class="field"><label class="check"><input type="checkbox" @bind="a.EtaDelay" /> ETA delay (Supply Risk / Critical) → Supply viewers</label></div>
                    <div class="field"><label class="check"><input type="checkbox" @bind="a.OpenPoOverdue" /> Open PO overdue (ETA passed) → Supply viewers</label></div>
                    <div class="field"><label class="check"><input type="checkbox" @bind="a.ActionsOverdue" /> Overdue S&amp;OP actions → their owner</label></div>
                    <div class="field"><label class="check"><input type="checkbox" @bind="a.RefreshFailures" /> Automated refresh failures → data administrators</label></div>
                    <div class="field"><label>Do not repeat the same alert for (days)</label><input type="number" min="0" max="90" @bind="a.RepeatAfterDays" /></div>
                    <div class="field"><label class="check"><input type="checkbox" @bind="a.SendEmail" /> Also send e-mail</label><div class="help">Requires SMTP on the server (Smtp:Host, Smtp:From). In-app notifications always work.</div></div>
                    @if (_alertResult is { } ar) { <div class="field full"><div class="alert ok">✔ @ar.Alerts new alert(s), @ar.Notifications notification(s), @ar.Emails e-mail(s).</div></div> }
                </div>
            </div>
            <div class="card">
                <div class="card-head"><h2>Coverage</h2><span class="hint">Coverage = available stock ÷ average monthly consumption</span></div>
                <div class="card-body form">
                    <div class="field"><label>Consumption basis</label>
                        <select @bind="s.Coverage.Basis">
                            <option value="@ConsumptionBasis.Forecast">Forecast (next N months)</option>
                            <option value="@ConsumptionBasis.History">History (last N months)</option>
                            <option value="@ConsumptionBasis.MaxOfBoth">Max of forecast and history</option>
                        </select></div>
                    <div class="field"><label>Months averaged (N)</label><input type="number" min="1" max="24" @bind="s.Coverage.AverageMonths" /></div>
                    <div class="field"><label>Critical below (months)</label><input type="number" step="0.1" @bind="s.Coverage.CriticalBelowMonths" /></div>
                    <div class="field"><label>Risk below (months)</label><input type="number" step="0.1" @bind="s.Coverage.RiskBelowMonths" /></div>
                    <div class="field"><label>Watch below (months)</label><input type="number" step="0.1" @bind="s.Coverage.WatchBelowMonths" /></div>
                    <div class="field"><label>Excess above (months)</label><input type="number" step="0.1" @bind="s.Coverage.ExcessAboveMonths" /></div>
                    <div class="field"><label class="check"><input type="checkbox" @bind="s.Coverage.IncludeInTransit" /> Count stock in transit as available</label></div>
                    <div class="field"><label class="check"><input type="checkbox" @bind="s.Coverage.IncludeOpenOrders" /> Count all open orders as available</label></div>
                </div>
            </div>
            <div class="card">
                <div class="card-head"><h2>Forecast &amp; service</h2></div>
                <div class="card-body form">
                    <div class="field"><label>On-track tolerance (± %)</label><input type="number" step="1" @bind="s.Forecast.OnTrackTolerancePct" /><div class="help">|Variance %| within this = On Track.</div></div>
                    <div class="field"><label>Forecast horizon (months)</label><input type="number" min="1" max="24" @bind="s.Forecast.HorizonMonths" /></div>
                    <div class="field"><label>Accuracy target (%)</label><input type="number" @bind="s.Forecast.AccuracyTargetPct" /></div>
                    <div class="field"><label>Service level target (%)</label><input type="number" @bind="s.Forecast.ServiceLevelTargetPct" /></div>
                    <div class="field"><label>Demand increase alert (%)</label><input type="number" @bind="s.Forecast.DemandIncreaseThresholdPct" /></div>
                </div>
            </div>
            <div class="card">
                <div class="card-head"><h2>Supply &amp; risk engine</h2></div>
                <div class="card-body form">
                    <div class="field"><label>ETA watch window (days)</label><input type="number" @bind="s.Supply.WatchWindowDays" /><div class="help">ETA within this many days of the required / stockout date = Watch.</div></div>
                    <div class="field"><label>On-time tolerance (days)</label><input type="number" @bind="s.Supply.OnTimeToleranceDays" /></div>
                    <div class="field"><label>In-full tolerance (%)</label><input type="number" @bind="s.Supply.InFullTolerancePct" /></div>
                    <div class="field"><label>OTIF target (%)</label><input type="number" @bind="s.Supply.OtifTargetPct" /></div>
                    <div class="field"><label>Port → warehouse (days)</label><input type="number" @bind="s.Supply.PortToWarehouseDays" /><div class="help">Clearing + delivery after arrival at port (estimated delivery, MRP lead time).</div></div>
                    <div class="field"><label>Supplier on-time alert (%)</label><input type="number" @bind="s.Supply.SupplierOnTimeAlertPct" /></div>
                    <div class="field full"><label>Transit days by country (overrides)</label>
                        <textarea @bind="_transit" placeholder="TR=30&#10;CN=45"></textarea><div class="help">One ISO code per line: CODE=days. Default transit times come from the country reference data.</div></div>
                </div>
            </div>
            <div class="card">
                <div class="card-head"><h2>Safety stock, TC &amp; general</h2></div>
                <div class="card-body form">
                    <div class="field"><label>Default safety stock (months of consumption)</label><input type="number" step="0.1" @bind="s.SafetyStock.DefaultMonths" /></div>
                    <div class="field"><label>Kg per TC (default)</label><input type="number" step="100" @bind="s.Tc.DefaultKgPerTc" /><div class="help">Used for KG items without a product TC conversion.</div></div>
                    <div class="field full"><label>Safety stock by product family (overrides)</label>
                        <textarea @bind="_safety" placeholder="FILMS=1.5&#10;DURUM=1"></textarea><div class="help">One family code per line: CODE=months.</div></div>
                    <div class="field"><label>Currency</label><input maxlength="5" @bind="s.General.Currency" /></div>
                    <div class="field"><label>Fiscal year starts in month</label><input type="number" min="1" max="12" @bind="s.General.FiscalYearStartMonth" /></div>
                    <div class="field full"><label>Departments</label><input @bind="_departments" /><div class="help">Comma-separated.</div></div>
                    <div class="field full"><label>Film families</label><input @bind="_films" /><div class="help">Product-family codes shown on the Films dashboard, comma-separated.</div></div>
                    <div class="field"><label>Slow moving window (months)</label><input type="number" min="1" max="24" @bind="s.Coverage.SlowMovingMonths" /></div>
                </div>
            </div>
        </div>
    }
</RequirePermission>

@code {
    private SettingsDto? _s;
    private string _transit = "", _safety = "", _departments = "", _films = "";
    private string? _error;
    private bool _ok, _saving;
    private AlertRunResult? _alertResult;

    private async Task RunAlerts()
    {
        _error = null; _saving = true;
        try { _alertResult = await Api.PostAsync<AlertRunResult>("api/alerts/run", new { }); }
        catch (ApiException ex) { _error = ex.Full; }
        finally { _saving = false; }
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _s = await Api.GetAsync<SettingsDto>("api/settings");
            _s = _s with { Alerts = _s.Alerts ?? new AlertSettings() };
            _transit = string.Join("\n", _s.Supply.TransitDaysByCountry.Select(kv => $"{kv.Key}={kv.Value}"));
            _safety = string.Join("\n", _s.SafetyStock.MonthsByCategory.Select(kv => $"{kv.Key}={kv.Value}"));
            _departments = string.Join(", ", _s.General.Departments);
            _films = string.Join(", ", _s.General.FilmCategories);
        }
        catch (ApiException ex) { _error = ex.Full; }
    }

    private async Task Save()
    {
        if (_s is null) return;
        _error = null; _ok = false; _saving = true;
        try
        {
            _s.Supply.TransitDaysByCountry = ParseMap(_transit, v => int.TryParse(v, out var d) ? d : (int?)null);
            _s.SafetyStock.MonthsByCategory = ParseMap(_safety, v => double.TryParse(v, System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, out var d) ? d : (double?)null);
            _s.General.Departments = _departments.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).ToList();
            _s.General.FilmCategories = _films.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).Select(c => c.ToUpperInvariant()).ToList();
            await Api.SendAsync(HttpMethod.Put, "api/settings", _s);
            _ok = true;
        }
        catch (FormatException ex) { _error = ex.Message; }
        catch (ApiException ex) { _error = ex.Full; }
        finally { _saving = false; }
    }

    private static Dictionary<string, T> ParseMap<T>(string text, Func<string, T?> parse) where T : struct
    {
        var map = new Dictionary<string, T>(StringComparer.OrdinalIgnoreCase);
        foreach (var line in text.Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
        {
            var parts = line.Split('=', 2, StringSplitOptions.TrimEntries);
            if (parts.Length != 2 || parts[0].Length == 0 || parse(parts[1].Replace(',', '.')) is not { } v)
                throw new FormatException($"Invalid line '{line}'. Expected CODE=value.");
            map[parts[0].ToUpperInvariant()] = v;
        }
        return map;
    }
}
