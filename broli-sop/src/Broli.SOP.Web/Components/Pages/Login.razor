@page "/login"
@inject ApiClient Api
@inject AuthSession Session
@inject FilterState Filters
@inject NavigationManager Nav

<PageTitle>Sign in · Broli S&amp;OP</PageTitle>

<div class="login-page">
    <section class="login-hero">
        <div class="brand" style="border:0;padding:0"><div class="brand-mark">B</div><div>Broli <small>S&amp;OP Portal</small></div></div>
        <div>
            <h1>Sales &amp; Operations Planning,<br />one view for every team.</h1>
            <p>Stock, coverage, supply, transit and risks — computed from the same data for Management, Supply, Sales, Finance, Production, Warehouse and Logistics.</p>
            <ul>
                <li>Do we have enough stock?</li>
                <li>Which products are at risk of stockout?</li>
                <li>Which orders are late, and what must we decide?</li>
            </ul>
        </div>
        <small style="color:#7f95b0">Internal use only · access is logged</small>
    </section>
    <section class="login-form">
        <form @onsubmit="SignIn" @onsubmit:preventDefault>
            <div>
                <h1 style="font-size:24px">Sign in</h1>
                <p class="muted" style="margin:4px 0 0">Use your Broli S&amp;OP account.</p>
            </div>
            @if (Expired) { <div class="alert warn">Your session has expired. Please sign in again.</div> }
            @if (_error is not null) { <div class="alert error" role="alert">@_error</div> }
            <div class="field">
                <label for="u">Username</label>
                <input id="u" autocomplete="username" @bind="_username" required autofocus />
            </div>
            <div class="field">
                <label for="p">Password</label>
                <input id="p" type="password" autocomplete="current-password" @bind="_password" required />
            </div>
            <button class="btn primary" type="submit" disabled="@_busy">@(_busy ? "Signing in…" : "Sign in")</button>
            <p class="muted" style="font-size:12px;margin:0">5 failed attempts lock the account for 15 minutes. Contact your administrator to reset a password.</p>
        </form>
    </section>
</div>

@code {
    [SupplyParameterFromQuery] public string? ReturnUrl { get; set; }
    [SupplyParameterFromQuery(Name = "expired")] public string? ExpiredFlag { get; set; }
    private bool Expired => ExpiredFlag == "1" && _error is null;

    private string _username = "", _password = "";
    private string? _error;
    private bool _busy;

    protected override async Task OnInitializedAsync()
    {
        await Session.RestoreAsync();
        if (Session.IsAuthenticated) Nav.NavigateTo(SafeReturn);
    }

    private string SafeReturn => ReturnUrl is { Length: > 0 } r && r.StartsWith('/') && !r.StartsWith("//") && !r.StartsWith("/login") ? r : "/";

    private async Task SignIn()
    {
        _busy = true;
        _error = null;
        try
        {
            var response = await Api.LoginAsync(new LoginRequest(_username.Trim(), _password));
            if (response is null)
            {
                _error = "Invalid username or password, or the account is temporarily locked.";
                return;
            }
            await Session.SignInAsync(response);
            Filters.Options = null;
            Nav.NavigateTo(SafeReturn);
        }
        catch (ApiException ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _password = "";
            _busy = false;
        }
    }
}
