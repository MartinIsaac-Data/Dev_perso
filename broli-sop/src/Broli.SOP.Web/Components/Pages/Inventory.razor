@page "/inventory"
@inherits SopPage

<PageTitle>Inventory · Broli S&amp;OP</PageTitle>

<RequirePermission Permission="@Permissions.InventoryView">
    <PageHeader Title="Inventory &amp; Coverage" Question="Do we have enough stock — and which products will run out first?" Period="_d?.Period">
        <Actions><ExportMenu Dataset="inventory" Query="_q" /></Actions>
    </PageHeader>

    <LoadState HasData="_d is not null" Error="@Error" OnRetry="ReloadAsync">
        @if (_d is { } d)
        {
            var s = d.Summary;
            <div class="kpis k4">
                @Tile("Opening Stock", Fmt.Num(s.OpeningTc, 1), "TC", "Closing stock of the previous month", "neutral", null)
                @Tile("Receipts", Fmt.Num(s.ReceiptsTc, 1), "TC", "Deliveries + production in the month", "neutral", null)
                @Tile("Consumption", Fmt.Num(s.ConsumptionTc, 1), "TC", "Sales + plant consumption", "neutral", null)
                @Tile("Closing Stock", Fmt.Num(s.ClosingTc, 1), "TC", s.StockValue is { } v ? $"Value {Fmt.Num(v)} {d.Currency}" : $"{s.SkuCount} SKUs", "neutral", "all")
                @Tile("Stock Coverage", Fmt.Months(s.CoverageMonths).Replace(" mo", ""), "months", $"Basis {d.CoverageBasis}, avg of {d.CoverageAverageMonths} months", "neutral", "coverage")
                @Tile("Safety Stock", Fmt.Num(s.SafetyStockTc, 1), "TC", $"{s.SkusBelowSafety} SKUs below safety stock", s.SkusBelowSafety > 0 ? "watch" : "good", "below-safety")
                @Tile("Excess Stock", Fmt.Num(s.ExcessTc, 1), "TC", s.ExcessValue is { } ev ? $"{s.SkusExcess} SKUs · {Fmt.Num(ev)} {d.Currency}" : $"{s.SkusExcess} SKUs above the excess threshold", s.SkusExcess > 0 ? "watch" : "good", "excess")
                @Tile("Stock at Risk", s.SkusAtRisk.ToString(), "SKUs", "Coverage in Critical or Risk band", s.SkusAtRisk > 0 ? "bad" : "good", "at-risk")
            </div>

            <div class="grid g-32 mb">
                <div class="card">
                    <div class="card-head"><h2>Stock evolution</h2><span class="hint">TC per month</span></div>
                    <div class="card-body">
                        <SopChart Type="bar" Height="270" Labels="d.Months" Unit="TC" AriaLabel="Receipts, consumption and closing stock by month"
                                  Datasets="@([new ChartDataset("Receipts", d.ReceiptsTc, "--series-3"), new ChartDataset("Consumption", d.ConsumptionTc, "--series-2"),
                                              new ChartDataset("Closing stock", d.ClosingTc, "--series-1", Type: "line")])" />
                    </div>
                </div>
                <div class="card">
                    <div class="card-head"><h2>Coverage status</h2><span class="hint">SKUs · click to list</span></div>
                    <div class="card-body">
                        <SopChart Type="bar" Height="270" Labels="d.CoverageDistribution.Select(p => p.Label).ToList()" Unit="SKUs" AriaLabel="Products per coverage status"
                                  Datasets="@([new ChartDataset("Products", d.CoverageDistribution.Select(p => p.Value).ToList(), "--series-1",
                                              PointColors: d.CoverageDistribution.Select(p => StatusColors.For(p.Label)).ToList())])"
                                  OnClick="c => SetView(StatusView(d.CoverageDistribution[c.Index].Key))" />
                    </div>
                </div>
            </div>

            <div class="card">
                <ViewTabs Current="@(_q.View ?? "")" OnSelect="SetView"
                          Items="@([("", "All"), ("at-risk", "At risk"), ("critical", "Critical"), ("risk", "Risk"), ("watch", "Watch"), ("normal", "Normal"), ("excess", "Excess"), ("below-safety", "Below safety"), ("nodemand", "No demand")])" />
                <div class="table-tools">
                    <input type="search" placeholder="Search CArtSAP, product, family, brand…" @bind="_q.Search" @bind:event="oninput" @bind:after="SearchChanged" />
                    <span class="muted">Coverage = available stock ÷ average monthly consumption (@d.CoverageBasis, @d.CoverageAverageMonths months). Quantities in each product's unit.</span>
                </div>
                <div class="table-wrap">
                    <table class="data">
                        <thead>
                            <tr>
                                <Th Query="_q" Field="CArtSap" OnChanged="LoadRows">Product</Th>
                                <Th Query="_q" Field="OpeningStock" Numeric OnChanged="LoadRows">Opening</Th>
                                <Th Query="_q" Field="Receipts" Numeric OnChanged="LoadRows">Receipts</Th>
                                <Th Query="_q" Field="Consumption" Numeric OnChanged="LoadRows">Consumption</Th>
                                <Th Query="_q" Field="ClosingStock" Numeric OnChanged="LoadRows">Closing</Th>
                                <Th Query="_q" Field="SafetyStock" Numeric OnChanged="LoadRows">Safety</Th>
                                <Th Query="_q" Field="CoverageMonths" Numeric OnChanged="LoadRows">Coverage</Th>
                                <Th Query="_q" Field="ExcessStock" Numeric OnChanged="LoadRows">Excess</Th>
                                <Th Query="_q" Field="StockoutDate" OnChanged="LoadRows">Stockout</Th>
                                <Th Query="_q" Field="NextEta" OnChanged="LoadRows">Next ETA</Th>
                                @if (_rows?.Items.Any(r => r.StockValue.HasValue) == true) { <Th Query="_q" Field="StockValue" Numeric OnChanged="LoadRows">Value</Th> }
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var r in _rows?.Items ?? [])
                            {
                                <tr class="click" @onclick="@(() => Go($"products/{Uri.EscapeDataString(r.CArtSap)}"))">
                                    <td><b>@r.Description</b><span class="sub">@r.CArtSap · @r.Category @(r.Brand is null ? "" : "· " + r.Brand)</span></td>
                                    <td class="num">@Fmt.Num(r.OpeningStock)</td>
                                    <td class="num">@Fmt.Num(r.Receipts)</td>
                                    <td class="num">@Fmt.Num(r.Consumption)</td>
                                    <td class="num"><b>@Fmt.Num(r.ClosingStock)</b> <span class="muted">@r.Unit</span></td>
                                    <td class="num">@Fmt.Num(r.SafetyStock) @if (r.BelowSafety) {<span title="Below safety stock" style="color:var(--serious-ink)"> ▲</span>}</td>
                                    <td class="num"><StatusBadge Status="@r.CoverageStatus" Text="@(r.CoverageMonths is null ? r.CoverageStatus : $"{Fmt.Months(r.CoverageMonths)} · {r.CoverageStatus}")" /></td>
                                    <td class="num">@(r.ExcessStock > 0 ? Fmt.Num(r.ExcessStock) : Fmt.Empty)</td>
                                    <td class="nowrap">@Fmt.Date(r.StockoutDate)</td>
                                    <td class="nowrap">@Fmt.Date(r.NextEta)</td>
                                    @if (r.StockValue.HasValue) { <td class="num">@Fmt.Compact(r.StockValue)</td> }
                                </tr>
                            }
                        </tbody>
                    </table>
                    @if (_rows is { Total: 0 }) { <div class="empty">No product matches this view and filter.</div> }
                </div>
                <Pager Query="_q" Total="@(_rows?.Total ?? 0)" OnChanged="LoadRows" />
            </div>
        }
    </LoadState>
</RequirePermission>

@code {
    [SupplyParameterFromQuery(Name = "view")] public string? View { get; set; }

    private InventoryDashboard? _d;
    private PagedResult<InventoryRow>? _rows;
    private readonly TableQuery _q = new();

    protected override async Task LoadAsync(CancellationToken ct)
    {
        if (_q.View != View) { _q.Sort = null; }
        _q.View = View;
        _q.Page = 1;
        var dash = Api.GetAsync<InventoryDashboard>("api/inventory", Filter, ct: ct);
        var rows = Api.GetAsync<PagedResult<InventoryRow>>("api/inventory/rows", Filter, _q, ct);
        _d = await dash;
        _rows = await rows;
    }

    private async Task LoadRows()
    {
        try { _rows = await Api.GetAsync<PagedResult<InventoryRow>>("api/inventory/rows", Filter, _q); }
        catch (ApiException ex) { Console.Error.WriteLine(ex.Message); }
    }

    private Task SearchChanged() { _q.Page = 1; return LoadRows(); }

    private void SetView(string v) => Go(v.Length == 0 ? "inventory" : $"inventory?view={v}");

    private static string StatusView(string? key) => key?.ToLowerInvariant() ?? "";
    private static string ViewKey(string view) => view == "all" ? "" : view;

    private RenderFragment Tile(string title, string value, string? unit, string? sub, string status, string? view) => __builder =>
    {
        if (view is null)
        {
            <div class="kpi @status">
                <div class="k-title"><span>@title</span></div>
                <div class="k-value">@value<span class="u">@unit</span></div>
                <div class="k-sub">@sub</div>
            </div>
        }
        else
        {
            <button type="button" class="kpi @status" @onclick="() => SetView(ViewKey(view))">
                <div class="k-title"><span>@title</span><span class="go">›</span></div>
                <div class="k-value">@value<span class="u">@unit</span></div>
                <div class="k-sub">@sub</div>
            </button>
        }
    };
}
