@page "/inventory"
@inherits SopPage

<PageTitle>Stocks · Broli S&amp;OP</PageTitle>

<RequirePermission Permission="@Permissions.InventoryView">
    <PageHeader Title="Stock et couverture" Question="Avons-nous assez de stock — et quels articles seront en rupture en premier ?" Period="_d?.Period">
        <Actions><ExportMenu Dataset="inventory" Query="_q" /></Actions>
    </PageHeader>

    <LoadState HasData="_d is not null" Error="@Error" OnRetry="ReloadAsync">
        @if (_d is { } d)
        {
            var s = d.Summary;
            <div class="kpis k4">
                @Tile("Stock initial", Fmt.Num(s.OpeningTc, 1), "TC", "Stock final du mois précédent", "neutral", null)
                @Tile("Réceptions", Fmt.Num(s.ReceiptsTc, 1), "TC", "Livraisons + production du mois", "neutral", null)
                @Tile("Consommation", Fmt.Num(s.ConsumptionTc, 1), "TC", "Ventes + consommation usine", "neutral", null)
                @Tile("Stock final", Fmt.Num(s.ClosingTc, 1), "TC", s.StockValue is { } v ? $"Valeur {Fmt.Num(v)} {d.Currency}" : $"{s.SkuCount} articles", "neutral", "all")
                @Tile("Couverture de stock", Fmt.Months(s.CoverageMonths).Replace(" mois", ""), "mois", $"Base : {d.CoverageBasis.ToLowerInvariant()}, moyenne sur {d.CoverageAverageMonths} mois", "neutral", "coverage")
                @Tile("Stock de sécurité", Fmt.Num(s.SafetyStockTc, 1), "TC", $"{s.SkusBelowSafety} articles sous le stock de sécurité", s.SkusBelowSafety > 0 ? "watch" : "good", "below-safety")
                @Tile("Stock excédentaire", Fmt.Num(s.ExcessTc, 1), "TC", s.ExcessValue is { } ev ? $"{s.SkusExcess} articles · {Fmt.Num(ev)} {d.Currency}" : $"{s.SkusExcess} articles au-dessus du seuil d'excédent", s.SkusExcess > 0 ? "watch" : "good", "excess")
                @Tile("Stock à risque", s.SkusAtRisk.ToString(), "articles", "Couverture en zone Critique ou Risque", s.SkusAtRisk > 0 ? "bad" : "good", "at-risk")
            </div>

            <div class="grid g-32 mb">
                <div class="card">
                    <div class="card-head"><h2>Évolution du stock</h2><span class="hint">TC par mois</span></div>
                    <div class="card-body">
                        <SopChart Type="bar" Height="270" Labels="d.Months" Unit="TC" AriaLabel="Réceptions, consommation et stock final par mois"
                                  Datasets="@([new ChartDataset("Réceptions", d.ReceiptsTc, "--series-3"), new ChartDataset("Consommation", d.ConsumptionTc, "--series-2"),
                                              new ChartDataset("Stock final", d.ClosingTc, "--series-1", Type: "line")])" />
                    </div>
                </div>
                <div class="card">
                    <div class="card-head"><h2>Statut de couverture</h2><span class="hint">Articles · cliquer pour la liste</span></div>
                    <div class="card-body">
                        <SopChart Type="bar" Height="270" Labels="d.CoverageDistribution.Select(p => p.Label).ToList()" Unit="articles" AriaLabel="Articles par statut de couverture"
                                  Datasets="@([new ChartDataset("Articles", d.CoverageDistribution.Select(p => p.Value).ToList(), "--series-1",
                                              PointColors: d.CoverageDistribution.Select(p => StatusColors.For(p.Label)).ToList())])"
                                  OnClick="c => SetView(StatusView(d.CoverageDistribution[c.Index].Key))" />
                    </div>
                </div>
            </div>

            <div class="card">
                <ViewTabs Current="@(_q.View ?? "")" OnSelect="SetView"
                          Items="@([("", "Tous"), ("at-risk", "À risque"), ("critical", "Critique"), ("risk", "Risque"), ("watch", "À surveiller"), ("normal", "Normal"), ("excess", "Excédent"), ("below-safety", "Sous stock de sécurité"), ("nodemand", "Sans demande")])" />
                <div class="table-tools">
                    <input type="search" placeholder="Rechercher CArtSAP, article, famille, marque…" @bind="_q.Search" @bind:event="oninput" @bind:after="SearchChanged" />
                    <span class="muted">Couverture = stock disponible ÷ consommation mensuelle moyenne (@d.CoverageBasis.ToLowerInvariant(), @d.CoverageAverageMonths mois). Quantités dans l'unité de chaque article.</span>
                </div>
                <div class="table-wrap">
                    <table class="data">
                        <thead>
                            <tr>
                                <Th Query="_q" Field="CArtSap" OnChanged="LoadRows">Article</Th>
                                <Th Query="_q" Field="OpeningStock" Numeric OnChanged="LoadRows">Initial</Th>
                                <Th Query="_q" Field="Receipts" Numeric OnChanged="LoadRows">Réceptions</Th>
                                <Th Query="_q" Field="Consumption" Numeric OnChanged="LoadRows">Consommation</Th>
                                <Th Query="_q" Field="ClosingStock" Numeric OnChanged="LoadRows">Final</Th>
                                <Th Query="_q" Field="SafetyStock" Numeric OnChanged="LoadRows">Sécurité</Th>
                                <Th Query="_q" Field="CoverageMonths" Numeric OnChanged="LoadRows">Couverture</Th>
                                <Th Query="_q" Field="ExcessStock" Numeric OnChanged="LoadRows">Excédent</Th>
                                <Th Query="_q" Field="StockoutDate" OnChanged="LoadRows">Rupture</Th>
                                <Th Query="_q" Field="NextEta" OnChanged="LoadRows">Prochaine ETA</Th>
                                @if (_rows?.Items.Any(r => r.StockValue.HasValue) == true) { <Th Query="_q" Field="StockValue" Numeric OnChanged="LoadRows">Valeur</Th> }
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var r in _rows?.Items ?? [])
                            {
                                <tr class="click" @onclick="@(() => Go($"products/{Uri.EscapeDataString(r.CArtSap)}"))">
                                    <td><b>@r.Description</b><span class="sub">@r.CArtSap · @r.Category @(r.Brand is null ? "" : "· " + r.Brand)</span></td>
                                    <td class="num">@Fmt.Num(r.OpeningStock)</td>
                                    <td class="num">@Fmt.Num(r.Receipts)</td>
                                    <td class="num">@Fmt.Num(r.Consumption)</td>
                                    <td class="num"><b>@Fmt.Num(r.ClosingStock)</b> <span class="muted">@r.Unit</span></td>
                                    <td class="num">@Fmt.Num(r.SafetyStock) @if (r.BelowSafety) {<span title="Sous le stock de sécurité" style="color:var(--serious-ink)"> ▲</span>}</td>
                                    <td class="num"><StatusBadge Status="@r.CoverageStatus" Text="@(r.CoverageMonths is null ? r.CoverageStatus : $"{Fmt.Months(r.CoverageMonths)} · {r.CoverageStatus}")" /></td>
                                    <td class="num">@(r.ExcessStock > 0 ? Fmt.Num(r.ExcessStock) : Fmt.Empty)</td>
                                    <td class="nowrap">@Fmt.Date(r.StockoutDate)</td>
                                    <td class="nowrap">@Fmt.Date(r.NextEta)</td>
                                    @if (r.StockValue.HasValue) { <td class="num">@Fmt.Compact(r.StockValue)</td> }
                                </tr>
                            }
                        </tbody>
                    </table>
                    @if (_rows is { Total: 0 }) { <div class="empty">Aucun article ne correspond à cette vue et à ces filtres.</div> }
                </div>
                <Pager Query="_q" Total="@(_rows?.Total ?? 0)" OnChanged="LoadRows" />
            </div>
        }
    </LoadState>
</RequirePermission>

@code {
    [SupplyParameterFromQuery(Name = "view")] public string? View { get; set; }

    private InventoryDashboard? _d;
    private PagedResult<InventoryRow>? _rows;
    private readonly TableQuery _q = new();

    protected override async Task LoadAsync(CancellationToken ct)
    {
        if (_q.View != View) { _q.Sort = null; }
        _q.View = View;
        _q.Page = 1;
        var dash = Api.GetAsync<InventoryDashboard>("api/inventory", Filter, ct: ct);
        var rows = Api.GetAsync<PagedResult<InventoryRow>>("api/inventory/rows", Filter, _q, ct);
        _d = await dash;
        _rows = await rows;
    }

    private async Task LoadRows()
    {
        try { _rows = await Api.GetAsync<PagedResult<InventoryRow>>("api/inventory/rows", Filter, _q); }
        catch (ApiException ex) { Console.Error.WriteLine(ex.Message); }
    }

    private Task SearchChanged() { _q.Page = 1; return LoadRows(); }

    private void SetView(string v) => Go(v.Length == 0 ? "inventory" : $"inventory?view={v}");

    private static string StatusView(string? key) => key?.ToLowerInvariant() ?? "";
    private static string ViewKey(string view) => view == "all" ? "" : view;

    private RenderFragment Tile(string title, string value, string? unit, string? sub, string status, string? view) => __builder =>
    {
        if (view is null)
        {
            <div class="kpi @status">
                <div class="k-title"><span>@title</span></div>
                <div class="k-value">@value<span class="u">@unit</span></div>
                <div class="k-sub">@sub</div>
            </div>
        }
        else
        {
            <button type="button" class="kpi @status" @onclick="() => SetView(ViewKey(view))">
                <div class="k-title"><span>@title</span><span class="go">›</span></div>
                <div class="k-value">@value<span class="u">@unit</span></div>
                <div class="k-sub">@sub</div>
            </button>
        }
    };
}
