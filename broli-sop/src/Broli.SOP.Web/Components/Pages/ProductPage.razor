@page "/products/{CArtSap}"
@inherits SopPage

<PageTitle>@(_d?.Info.Description ?? CArtSap) · Broli S&amp;OP</PageTitle>

<RequirePermission Permission="@Permissions.InventoryView">
    <PageHeader Title="@(_d is null ? CArtSap : _d.Info.Description)" Period="_d?.Period"
                Question="@(_d is null ? null : $"{_d.Info.CArtSap} · {_d.Info.Category}{(_d.Info.Brand is null ? "" : " · " + _d.Info.Brand)} · {_d.Info.MaterialType}{(_d.Info.MainSupplier is null ? "" : " · supplier " + _d.Info.MainSupplier)}")">
        <Crumbs><a href="" @onclick="Back" @onclick:preventDefault>‹ Back</a> · <a href="inventory">Inventory</a> · Product</Crumbs>
        <Actions>
            @if (_d is not null) { <StatusBadge Status="@_d.Position.CoverageStatus" Text="@($"{_d.Position.CoverageStatus} · {Fmt.Months(_d.Position.CoverageMonths)}")" /> }
            <button class="btn sm" @onclick="@(() => JS.InvokeVoidAsync("sop.print"))">⎙ Print / PDF</button>
        </Actions>
    </PageHeader>

    <LoadState HasData="_d is not null" Error="@Error" OnRetry="ReloadAsync">
        @if (_d is { } d)
        {
            var p = d.Position;
            <div class="card mb">
                <div class="facts">
                    <div><span>Stock (end @d.Period.AsOfMonth.ToString("MMM"))</span><b>@Fmt.Num(p.ClosingStock) @p.Unit</b>@if (p.ClosingTc is { } tc) {<span>≈ @Fmt.Num(tc, 1) TC</span>}</div>
                    <div><span>Avg consumption / month</span><b>@Fmt.Num(p.AvgMonthlyConsumption) @p.Unit</b></div>
                    <div><span>Coverage</span><b>@Fmt.Months(p.CoverageMonths)</b><span>@p.CoverageStatus</span></div>
                    <div><span>Projected stockout</span><b style="color:@(p.StockoutDate is null ? "inherit" : "var(--critical-ink)")">@Fmt.Date(p.StockoutDate)</b><span>@(p.StockoutDate is null ? "not within the horizon" : "incl. open supply")</span></div>
                    <div><span>Safety stock</span><b>@Fmt.Num(p.SafetyStock) @p.Unit</b><span>@(p.BelowSafety ? "▲ stock below safety" : "covered")</span></div>
                    <div><span>Open supply</span><b>@Fmt.Num(p.OpenSupplyQty) @p.Unit</b><span>@Fmt.Num(p.InTransitQty) in transit</span></div>
                    <div><span>Next ETA</span><b>@Fmt.Date(p.NextEta)</b></div>
                    <div><span>@(p.StockValue is null ? "Excess stock" : "Stock value")</span><b>@(p.StockValue is { } v ? Fmt.Num(v) : Fmt.Num(p.ExcessStock) + " " + p.Unit)</b></div>
                </div>
            </div>

            <div class="card actions-panel mb">
                <div class="card-head"><h2>Recommended actions</h2><span class="hint">computed from stock, forecast and open orders</span></div>
                <div class="card-body flush">
                    @foreach (var a in d.Actions)
                    {
                        <div class="action-item">
                            <span class="sev"><StatusBadge Status="@(a.Severity == "info" ? "OK" : a.Severity)" Text="@Severity(a.Severity)" /></span>
                            <div><b>@a.Title</b><p>@a.Detail</p></div>
                        </div>
                    }
                </div>
            </div>

            <div class="card mb">
                <div class="card-head"><h2>Open orders &amp; ETA</h2><span class="hint">@d.OpenOrders.Count open line(s)</span></div>
                <div class="card-body flush table-wrap">
                    @if (d.OpenOrders.Count == 0)
                    {
                        <div class="empty">No open supply for this product.@(d.Info.MaterialType == "Finished Good" ? " Finished goods are replenished by production." : "")</div>
                    }
                    else
                    {
                        <table class="data">
                            <thead><tr><th>PO</th><th>Supplier</th><th class="num">Quantity</th><th>ETD</th><th>ETA</th><th>Required</th><th>Status</th><th>Stockout before ETA</th><th>Risk</th></tr></thead>
                            <tbody>
                                @foreach (var o in d.OpenOrders)
                                {
                                    <tr>
                                        <td class="code">@o.PoNumber<span class="sub">ordered @Fmt.Date(o.OrderDate)</span></td>
                                        <td>@o.Supplier<span class="sub">@o.Country @(o.BillOfLading is null ? "" : "· BL " + o.BillOfLading)</span></td>
                                        <td class="num">@Fmt.Num(o.Quantity) <span class="muted">@o.Unit</span><span class="sub">@Fmt.Num(o.Tc, 1) TC</span></td>
                                        <td class="nowrap">@Fmt.Date(o.Etd)</td>
                                        <td class="nowrap"><b>@Fmt.Date(o.Eta)</b>@if (o.TransitDays is { } t) {<span class="sub">@t d transit</span>}</td>
                                        <td class="nowrap">@Fmt.Date(o.RequiredDate)</td>
                                        <td><span class="badge st-neutral">@o.Status</span>@if (o.CustomsStatus is not null) {<span class="sub">@o.CustomsStatus</span>}</td>
                                        <td class="nowrap">@Fmt.Date(o.StockoutDate)</td>
                                        <td><StatusBadge Status="@o.RiskLevel" />@if (o.RiskReason is not null) {<span class="sub">@o.RiskReason</span>}</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                </div>
            </div>

            <div class="grid g-2 mb">
                <div class="card">
                    <div class="card-head"><h2>History — stock, actual and forecast</h2><span class="hint">@p.Unit per month</span></div>
                    <div class="card-body">
                        <SopChart Type="bar" Height="260" Labels="d.HistoryMonths" Unit="@p.Unit" AriaLabel="Monthly stock, actual and forecast"
                                  Datasets="@([new ChartDataset("Forecast", d.HistoryForecast, "--series-1", Type: "line", Dashed: true),
                                              new ChartDataset("Actual", d.HistoryActual, "--series-2", Type: "line"),
                                              new ChartDataset("Month-end stock", d.HistoryStock, "--series-3")])" />
                    </div>
                </div>
                <div class="card">
                    <div class="card-head"><h2>Projected stock</h2><span class="hint">opening + incoming − forecast</span></div>
                    <div class="card-body flush table-wrap">
                        <table class="data">
                            <thead><tr><th>Month</th><th class="num">Opening</th><th class="num">Incoming</th><th class="num">Forecast</th><th class="num">Closing</th><th>Coverage</th></tr></thead>
                            <tbody>
                                @foreach (var m in d.Projection)
                                {
                                    <tr>
                                        <td>@m.Month</td>
                                        <td class="num">@Fmt.Num(m.Opening)</td>
                                        <td class="num">@(m.Incoming > 0 ? "+" + Fmt.Num(m.Incoming) : Fmt.Empty)</td>
                                        <td class="num">−@Fmt.Num(m.Forecast)</td>
                                        <td class="num"><b>@Fmt.Num(m.Closing)</b></td>
                                        <td><StatusBadge Status="@m.CoverageStatus" Text="@(m.CoverageMonths is null ? m.CoverageStatus : Fmt.Months(m.CoverageMonths))" /></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                        <div class="chart-note" style="padding:8px 12px">Monthly view: a stockout inside a month can be hidden when a delivery arrives later that month — see "Projected stockout" above (daily simulation).</div>
                    </div>
                </div>
            </div>

            @if (d.RegisterItems.Count > 0)
            {
                <div class="card">
                    <div class="card-head"><h2>Tracked risks &amp; opportunities</h2><a class="hint" href="risks">Risk register ›</a></div>
                    <div class="card-body flush table-wrap">
                        <table class="data">
                            <thead><tr><th>ID</th><th>Description</th><th>Owner</th><th>Action</th><th>Due</th><th>Status</th></tr></thead>
                            <tbody>
                                @foreach (var r in d.RegisterItems)
                                {
                                    <tr><td class="code">@r.Code</td><td>@r.Description<span class="sub">@r.Category · impact @r.Impact · @r.Probability%</span></td><td>@r.Owner</td><td>@r.Action</td>
                                        <td class="nowrap">@Fmt.Date(r.DueDate)@if (r.IsOverdue) {<span class="sub" style="color:var(--critical-ink)">overdue</span>}</td><td><StatusBadge Status="@r.Status" /></td></tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
        }
    </LoadState>
</RequirePermission>

@code {
    [Parameter] public string CArtSap { get; set; } = "";
    private ProductDetail? _d;

    protected override async Task LoadAsync(CancellationToken ct) =>
        _d = await Api.GetAsync<ProductDetail>($"api/products/{Uri.EscapeDataString(CArtSap)}", Filter, ct: ct);

    private static string Severity(string s) => s switch { "critical" => "Critical", "high" => "High", "medium" => "Medium", _ => "Info" };

    private async Task Back() => await JS.InvokeVoidAsync("history.back");
}
