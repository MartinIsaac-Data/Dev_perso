@page "/mrp"
@inherits SopPage

<PageTitle>MRP · Broli S&amp;OP</PageTitle>

<RequirePermission Permission="@Permissions.SupplyView">
    <PageHeader Title="MRP — besoins nets" Question="Que devons-nous commander ou produire, en quelle quantité et pour quand ?" Period="_d?.Period">
        <Actions><ExportMenu Dataset="mrp" Query="_q" /></Actions>
    </PageHeader>

    <LoadState HasData="_d is not null" Error="@Error" OnRetry="ReloadAsync">
        @if (_d is { } d)
        {
            <div class="kpis">
                @Tile("Articles à réapprovisionner", d.SkusWithRequirement.ToString(), null, $"Besoin net sur {d.HorizonMonths.Count} mois", d.SkusWithRequirement > 0 ? "watch" : "good", "")
                @Tile("À commander sous 7 jours", d.OrdersToPlaceNow.ToString(), "articles", "Date limite de commande atteinte ou cette semaine", d.OrdersToPlaceNow > 0 ? "watch" : "good", "now")
                @Tile("Déjà en retard", d.OrdersLate.ToString(), "articles", "Date limite dépassée : accélérer ou replanifier", d.OrdersLate > 0 ? "bad" : "good", "late")
                @Tile("Recommandé", Fmt.Num(d.RecommendedTc, 1), "TC", d.RecommendedValue is { } v ? $"≈ {Fmt.Num(v)} {d.Currency}" : "Arrondi au conteneur complet si pertinent", "neutral", "")
                @Tile("Horizon", $"{d.HorizonMonths.FirstOrDefault()} – {d.HorizonMonths.LastOrDefault()}", null, "Horizon de prévision (Configuration)", "neutral", "all")
            </div>

            <div class="grid g-2 mb">
                <div class="card">
                    <div class="card-head"><h2>Prévision vs approvisionnements attendus</h2><span class="hint">TC par mois · approvisionnements en retard dans le premier mois</span></div>
                    <div class="card-body">
                        <SopChart Type="bar" Height="250" Labels="d.HorizonMonths" Unit="TC" AriaLabel="Prévision et approvisionnements attendus par mois"
                                  Datasets="@([new ChartDataset("Prévision", d.ForecastByMonthTc, "--series-1"), new ChartDataset("Appro attendu", d.IncomingByMonthTc, "--series-3")])" />
                    </div>
                </div>
                <div class="card">
                    <div class="card-head"><h2>Commandes recommandées par famille</h2><span class="hint">TC</span></div>
                    <div class="card-body">
                        @if (d.RequirementByCategoryTc.Count == 0) { <div class="empty">✔ Aucun besoin sur l'horizon.</div> }
                        else
                        {
                            <SopChart Type="bar" Horizontal="true" Height="@(Math.Max(160, d.RequirementByCategoryTc.Count * 28 + 40))" Unit="TC"
                                      Labels="d.RequirementByCategoryTc.Select(p => p.Label).ToList()" AriaLabel="Conteneurs recommandés par famille"
                                      Datasets="@([new ChartDataset("Recommandé", d.RequirementByCategoryTc.Select(p => p.Value).ToList(), "--series-1")])" />
                        }
                    </div>
                </div>
            </div>

            <div class="card">
                <ViewTabs Current="@(_q.View ?? "")" OnSelect="SetView" Items="@([("", "À réapprovisionner"), ("now", "À commander cette semaine"), ("late", "En retard"), ("all", "Tous les articles")])" />
                <div class="table-tools">
                    <input type="search" placeholder="Rechercher CArtSAP, article, famille, fournisseur…" @bind="_q.Search" @bind:event="oninput" @bind:after="SearchChanged" />
                    <span class="muted">Recommandé = besoin net (Σ prévision + sécurité − stock − commandes − transit) arrondi au TC. Commander avant = date de besoin − délai.</span>
                </div>
                <div class="table-wrap">
                    <table class="data dense">
                        <thead>
                            <tr>
                                <Th Query="_q" Field="CArtSap" OnChanged="LoadRows">CArtSAP / désignation</Th>
                                <Th Query="_q" Field="OpeningStock" Numeric OnChanged="LoadRows">Stock</Th>
                                @for (var i = 0; i < d.HorizonMonths.Count; i++) { <th class="num">@d.HorizonMonths[i]<span class="sub">M+@(i + 1)</span></th> }
                                <Th Query="_q" Field="OpenOrder" Numeric OnChanged="LoadRows">Commandes / transit</Th>
                                <Th Query="_q" Field="ProjectedStock" Numeric OnChanged="LoadRows">Projeté</Th>
                                <Th Query="_q" Field="CoverageMonths" Numeric OnChanged="LoadRows">Couverture</Th>

                                <Th Query="_q" Field="RecommendedOrder" Numeric OnChanged="LoadRows">Recommandé</Th>
                                <Th Query="_q" Field="OrderByDate" OnChanged="LoadRows">Commander avant</Th>
                                <Th Query="_q" Field="Risk" OnChanged="LoadRows">Risque</Th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var r in _rows?.Items ?? [])
                            {
                                <tr class="click" @onclick="@(() => Go($"products/{Uri.EscapeDataString(r.CArtSap)}"))">
                                    <td style="min-width:170px"><b>@r.Description</b><span class="sub">@r.CArtSap · @r.Category</span></td>
                                    <td class="num">@Fmt.Num(r.OpeningStock) <span class="muted">@r.Unit</span></td>
                                    @foreach (var f in r.Forecast) { <td class="num">@Fmt.Num(f)</td> }
                                    <td class="num">@Fmt.Num(r.OpenOrder + r.InTransit)@if (r.InTransit > 0) {<span class="sub">@Fmt.Num(r.InTransit) en transit</span>}</td>
                                    <td class="num" style="@(r.ProjectedStock < 0 ? "color:var(--critical-ink);font-weight:600" : "")">@Fmt.Num(r.ProjectedStock)</td>
                                    <td class="num"><StatusBadge Status="@r.CoverageStatus" Text="@(r.CoverageMonths is null ? r.CoverageStatus : Fmt.Months(r.CoverageMonths))" /></td>
                                    <td class="num"><b>@(r.RecommendedOrder > 0 ? Fmt.Num(r.RecommendedOrder) : Fmt.Empty)</b><span class="sub">net @Fmt.Num(r.NetRequirement)@(r.RecommendedTc is > 0 ? $" · {Fmt.Num(r.RecommendedTc, 1)} TC" : "")</span></td>
                                    <td class="nowrap">@Fmt.Date(r.OrderByDate)@if (r.DaysLate is > 0) {<span class="sub" style="color:var(--critical-ink)">▲ @r.DaysLate j de retard</span>} else if (r.LeadTimeDays is { } lt) {<span class="sub">délai @lt j</span>}</td>
                                    <td><StatusBadge Status="@r.Risk" /></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    @if (_rows is { Total: 0 }) { <div class="empty">✔ Rien à commander pour cette vue et ces filtres.</div> }
                </div>
                <Pager Query="_q" Total="@(_rows?.Total ?? 0)" OnChanged="LoadRows" />
            </div>
        }
    </LoadState>
</RequirePermission>

@code {
    [SupplyParameterFromQuery(Name = "view")] public string? View { get; set; }
    private MrpDashboard? _d;
    private PagedResult<MrpRow>? _rows;
    private readonly TableQuery _q = new();

    protected override async Task LoadAsync(CancellationToken ct)
    {
        if (_q.View != View) _q.Sort = null;
        _q.View = View;
        _q.Page = 1;
        var dash = Api.GetAsync<MrpDashboard>("api/mrp", Filter, ct: ct);
        var rows = Api.GetAsync<PagedResult<MrpRow>>("api/mrp/rows", Filter, _q, ct);
        _d = await dash;
        _rows = await rows;
    }

    private async Task LoadRows()
    {
        try { _rows = await Api.GetAsync<PagedResult<MrpRow>>("api/mrp/rows", Filter, _q); }
        catch (ApiException ex) { Console.Error.WriteLine(ex.Message); }
    }

    private Task SearchChanged() { _q.Page = 1; return LoadRows(); }
    private void SetView(string v) => Go(v.Length == 0 ? "mrp" : $"mrp?view={v}");

    private RenderFragment Tile(string title, string value, string? unit, string sub, string status, string view) => __builder =>
    {
        <button type="button" class="kpi @status" @onclick="() => SetView(view)">
            <div class="k-title"><span>@title</span><span class="go">›</span></div>
            <div class="k-value">@value@if (unit is not null) {<span class="u">@unit</span>}</div>
            <div class="k-sub">@sub</div>
        </button>
    };
}
