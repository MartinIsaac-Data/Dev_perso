@page "/data"
@inject ApiClient Api
@inject IJSRuntime JS
@inject FilterState Filters

<PageTitle>Gestion des données · Broli S&amp;OP</PageTitle>

<RequirePermission Permission="@Permissions.DataImport">
    <PageHeader Title="Gestion des données" Question="Charger les fichiers Excel mensuels en toute sécurité — aucune donnée invalide n'est jamais importée." />

    @if (_status is { } st)
    {
        <div class="card mb">
            <div class="card-head"><h2>Données actuelles</h2>
                @if (st.HasDemoData) { <button class="btn sm danger" @onclick="() => _confirmPurge = true">Supprimer les données de DÉMO</button> }
            </div>
            <div class="card-body">
                @if (st.HasDemoData)
                {
                    <div class="alert warn">◆ <div><b>Des données de DÉMO sont chargées.</b> Elles sont supprimées automatiquement lors de l'import du premier vrai fichier SUPPLIER MASTER ou PRODUCT MASTER : les chiffres de démo ne se mélangent jamais aux vrais. Ordre recommandé : référentiel fournisseurs → référentiel produits → stocks, ventes, prévisions, approvisionnements.</div></div>
                }
                <div class="facts" style="border:1px solid var(--border);border-radius:8px">
                    @foreach (var (k, v) in st.RowCounts) { <div><span>@CountLabel(k)</span><b>@v.ToString("N0")</b></div> }
                    <div><span>Dernier mois de stock</span><b>@(st.LatestStockMonth?.ToString("MMMM yyyy") ?? Fmt.Empty)</b></div>
                    <div><span>Dernier import</span><b>@Fmt.DateTime(st.LastImportUtc)</b></div>
                </div>
            </div>
        </div>
    }

    <div class="grid g-32 mb">
        <div class="card">
            <div class="card-head"><h2>Importer un fichier Excel</h2></div>
            <div class="card-body">
                <div class="steps">
                    <span class="@Step(1)">1 · Type de fichier</span><span class="@Step(2)">2 · Chargement</span><span class="@Step(3)">3 · Validation et aperçu</span><span class="@Step(4)">4 · Import</span>
                </div>
                @if (_error is not null) { <div class="alert error" role="alert">✖ <div>@_error</div></div> }
                @if (_result is { } res)
                {
                    <div class="alert ok">✔ <div><b>Import terminé.</b> @res.Inserted lignes ajoutées, @res.Updated mises à jour, @res.Warnings avertissements.@(res.PurgedDemoData ? " Les données de DÉMO ont été supprimées." : "") Les tableaux de bord utilisent désormais ces données.</div></div>
                }
                <div class="form" style="margin-bottom:12px">
                    <div class="field">
                        <label for="type">Type de fichier</label>
                        <select id="type" @bind="_type" @bind:after="ResetPreview">
                            <option value="">— choisir —</option>
                            @foreach (var t in _templates) { <option value="@t.Type">@t.Title</option> }
                        </select>
                        @if (Selected is { } sel) { <div class="help">@sel.Description</div> }
                    </div>
                    <div class="field">
                        <label>Classeur Excel (.xlsx, 25 Mo maximum)</label>
                        <InputFile OnChange="Upload" accept=".xlsx" disabled="@(string.IsNullOrEmpty(_type) || _busy)" />
                        @if (_busy) { <div class="help">Lecture et validation…</div> }
                    </div>
                </div>

                @if (_preview is { } p)
                {
                    <div class="kpis k4" style="margin-top:8px">
                        <div class="kpi neutral"><div class="k-title">Lignes lues</div><div class="k-value">@p.RowCount.ToString("N0")</div><div class="k-sub">@p.FileName</div></div>
                        <div class="kpi @(p.ValidRowCount == p.RowCount ? "good" : "watch")"><div class="k-title">Lignes valides</div><div class="k-value">@p.ValidRowCount.ToString("N0")</div></div>
                        <div class="kpi @(p.ErrorCount > 0 ? "bad" : "good")"><div class="k-title">Erreurs</div><div class="k-value">@p.ErrorCount</div><div class="k-sub">@(p.ErrorCount > 0 ? "import bloqué" : "aucune")</div></div>
                        <div class="kpi @(p.WarningCount > 0 ? "watch" : "good")"><div class="k-title">Avertissements</div><div class="k-value">@p.WarningCount</div><div class="k-sub">autorisés, à vérifier</div></div>
                    </div>
                    @if (p.WillPurgeDemoData) { <div class="alert warn">◆ L'import de ce fichier supprimera d'abord toutes les données de DÉMO.</div> }
                    @if (p.Issues.Count > 0)
                    {
                        <h3 style="margin:10px 0 6px">Anomalies</h3>
                        <div class="table-wrap" style="max-height:280px;overflow-y:auto;border:1px solid var(--border);border-radius:8px">
                            <table class="data">
                                <thead><tr><th>Gravité</th><th class="num">Ligne Excel</th><th>Colonne</th><th>Message</th></tr></thead>
                                <tbody>
                                    @foreach (var i in p.Issues.Take(300))
                                    {
                                        <tr><td><StatusBadge Status="@(i.Severity == "Error" ? "Critical" : "Watch")" Text="@(i.Severity == "Error" ? "Erreur" : "Avertissement")" /></td>
                                            <td class="num">@(i.Row == 0 ? "fichier" : i.Row.ToString())</td><td>@i.Column</td><td>@i.Message</td></tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                        @if (p.Issues.Count > 300) { <p class="muted">300 anomalies affichées sur @p.Issues.Count.</p> }
                    }
                    @if (p.SampleRows.Count > 0)
                    {
                        <h3 style="margin:14px 0 6px">Aperçu (@p.SampleRows.Count premières lignes)</h3>
                        <div class="table-wrap" style="max-height:260px;overflow:auto;border:1px solid var(--border);border-radius:8px">
                            <table class="data">
                                <thead><tr>@foreach (var c in p.Columns) { <th>@c</th> }</tr></thead>
                                <tbody>@foreach (var row in p.SampleRows) { <tr>@foreach (var c in p.Columns) { <td>@(row.TryGetValue(c, out var v) ? v : "")</td> }</tr> }</tbody>
                            </table>
                        </div>
                    }
                    <div class="toolbar" style="margin-top:14px">
                        <button class="btn primary" disabled="@(!p.CanCommit || _busy)" @onclick="Commit">
                            @(p.CanCommit ? $"Importer {p.ValidRowCount:N0} lignes" : "Corrigez les erreurs dans Excel, puis chargez à nouveau le fichier")
                        </button>
                        <button class="btn" @onclick="ResetPreview">Annuler</button>
                    </div>
                }
            </div>
        </div>
        <div class="card">
            <div class="card-head"><h2>Modèles standard</h2><span class="hint">en-têtes foncés = obligatoires</span></div>
            <div class="card-body flush">
                @foreach (var t in _templates)
                {
                    <div class="action-item">
                        <div style="flex:1"><b>@t.Title</b><p>@t.Description</p><p class="muted" style="font-size:12px">Obligatoires : @string.Join(", ", t.RequiredColumns)</p></div>
                        <button class="btn sm" @onclick="() => DownloadTemplate(t.Type)">⤓ .xlsx</button>
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="card mb">
        <div class="card-head">
            <h2>Sources automatiques (ERP / dossier de dépôt)</h2>
            <div class="toolbar">
                <button class="btn sm" @onclick="RunAll" disabled="@(_busy || _sources.Count == 0)">⟳ Tout rafraîchir maintenant</button>
                <button class="btn sm primary" @onclick="NewSource">+ Ajouter une source</button>
            </div>
        </div>
        <div class="card-body" style="padding-bottom:4px">
            <p class="muted" style="margin:0 0 8px">Les sources passent par la même validation que les chargements manuels : une source contenant une erreur est rejetée entièrement et signalée aux administrateurs des données.
                Planificateur @(_info?.SchedulerEnabled == true ? "actif" : "inactif") · dossier de dépôt @(_info?.InboxRoot ?? "non configuré") · connexions ERP : @(_info is { ConnectionNames.Count: > 0 } inf ? string.Join(", ", inf.ConnectionNames) : "aucune configurée").</p>
            @if (_runResults.Count > 0)
            {
                <div class="alert @(_runResults.Any(r => r.Status is "Rejected" or "Failed") ? "warn" : "ok")">
                    <div>@foreach (var r in _runResults) { <div><b>@r.Source</b> — @RunStatus(r.Status) : @r.Message</div> }</div>
                </div>
            }
        </div>
        <div class="card-body flush table-wrap">
            <table class="data">
                <thead><tr><th>Source</th><th>Type</th><th>Origine</th><th>Planification</th><th>Dernière exécution</th><th>Résultat</th><th></th></tr></thead>
                <tbody>
                    @foreach (var s in _sources)
                    {
                        <tr>
                            <td><b>@s.Name</b>@if (!s.Enabled) {<span class="sub">désactivée</span>}</td>
                            <td>@(_templates.FirstOrDefault(t => t.Type == s.ImportType)?.Title ?? s.ImportType)</td>
                            <td class="code">@(s.Kind == "SqlStaging" ? $"{s.ConnectionName} : {s.Location}" : $"inbox/{s.Location}/*.xlsx")</td>
                            <td>@(s.DailyAt is null ? "manuelle" : "chaque jour à " + s.DailyAt)</td>
                            <td class="nowrap">@Fmt.DateTime(s.LastRunUtc)</td>
                            <td>@if (s.LastStatus is { } last) {<StatusBadge Status="@(last == "Imported" ? "OK" : last == "No data" ? "neutral" : "Critical")" Text="@RunStatus(last)" />}<span class="sub">@s.LastMessage</span></td>
                            <td class="nowrap"><button class="btn sm" @onclick="() => RunSource(s)" disabled="@_busy">Lancer</button> <button class="btn sm" @onclick="() => EditSource(s)">Modifier</button></td>
                        </tr>
                    }
                </tbody>
            </table>
            @if (_sources.Count == 0) { <div class="empty">Aucune source automatique pour le moment. Les chargements manuels ci-dessus restent disponibles.</div> }
        </div>
    </div>

    <div class="card">
        <div class="card-head"><h2>Historique des imports</h2></div>
        <div class="card-body flush table-wrap">
            <table class="data">
                <thead><tr><th>Date</th><th>Type</th><th>Fichier / source</th><th>Par</th><th>Statut</th><th class="num">Lignes</th><th class="num">Ajoutées</th><th class="num">Mises à jour</th><th class="num">Avertissements</th></tr></thead>
                <tbody>
                    @foreach (var b in _history)
                    {
                        <tr><td class="nowrap">@Fmt.DateTime(b.UploadedAtUtc)</td><td>@b.Type</td><td>@b.FileName<span class="sub">@(b.Source == "Manual upload" ? "Chargement manuel" : b.Source)</span></td><td>@b.UploadedBy</td>
                            <td><StatusBadge Status="@(b.Status == "Committed" ? "OK" : "Critical")" Text="@BatchStatus(b.Status)" />@if (b.Message is not null) {<span class="sub" style="white-space:pre-line;max-width:320px;display:block">@b.Message</span>}</td>
                            <td class="num">@b.RowCount.ToString("N0")</td><td class="num">@b.Inserted.ToString("N0")</td><td class="num">@b.Updated.ToString("N0")</td><td class="num">@b.Warnings</td></tr>
                    }
                </tbody>
            </table>
            @if (_history.Count == 0) { <div class="empty">Aucun fichier importé pour le moment.</div> }
        </div>
    </div>

    @if (_source is not null)
    {
        <div class="modal-back" @onclick="() => _source = null">
            <div class="modal" @onclick:stopPropagation role="dialog" aria-modal="true" aria-label="Source de données">
                <div class="modal-head"><h2>@(_sourceId is null ? "Nouvelle source automatique" : "Modifier " + _source.Name)</h2><button class="icon-btn" @onclick="() => _source = null">✕</button></div>
                <div class="modal-body">
                    @if (_sourceError is not null) { <div class="alert error">@_sourceError</div> }
                    <div class="form">
                        <div class="field"><label>Nom</label><input @bind="_source.Name" maxlength="100" /></div>
                        <div class="field"><label>Données</label><select @bind="_source.ImportType">@foreach (var t in _templates) { <option value="@t.Type">@t.Title</option> }</select></div>
                        <div class="field"><label>Type de source</label>
                            <select @bind="_source.Kind"><option value="SqlStaging">Table ou vue SQL de staging (ERP)</option><option value="ExcelFolder">Fichiers Excel déposés dans un dossier</option></select></div>
                        @if (_source.Kind == "SqlStaging")
                        {
                            <div class="field"><label>Connexion</label>
                                <select @bind="_source.ConnectionName"><option value="">— choisir —</option>@foreach (var c in _info?.ConnectionNames ?? []) { <option>@c</option> }</select>
                                <div class="help">Les chaînes de connexion sont définies sur le serveur (ConnectionStrings:&lt;nom&gt;), jamais ici.</div></div>
                            <div class="field full"><label>Table ou vue</label><input @bind="_source.Location" placeholder="dbo.V_SOP_INVENTORY" />
                                <div class="help">Colonnes nommées comme dans le modèle Excel (alias acceptés). Lecture par SELECT * — utilisez un compte en lecture seule.</div></div>
                        }
                        else
                        {
                            <div class="field full"><label>Sous-dossier de dépôt</label><input @bind="_source.Location" placeholder="inventory" />
                                <div class="help">Les fichiers vont dans @(_info?.InboxRoot ?? "<dépôt>")/@(_source.Location)/ — les fichiers traités sont déplacés dans processed/, les fichiers rejetés dans rejected/ avec un rapport d'erreurs.</div></div>
                        }
                        <div class="field"><label>Lancer chaque jour à (HH:mm)</label><input @bind="_source.DailyAt" placeholder="06:00" /><div class="help">Vide = manuel uniquement.</div></div>
                        <div class="field"><label>&nbsp;</label><label class="check"><input type="checkbox" @bind="_source.Enabled" /> Activée</label></div>
                    </div>
                </div>
                <div class="modal-foot">
                    @if (_sourceId is not null) { <button class="btn danger" style="margin-right:auto" @onclick="DeleteSource">Supprimer</button> }
                    <button class="btn" @onclick="() => _source = null">Annuler</button><button class="btn primary" @onclick="SaveSource">Enregistrer</button>
                </div>
            </div>
        </div>
    }

    @if (_confirmPurge)
    {
        <div class="modal-back" @onclick="() => _confirmPurge = false">
            <div class="modal" style="width:min(480px,100%)" @onclick:stopPropagation role="alertdialog" aria-modal="true">
                <div class="modal-head"><h2>Supprimer toutes les données de DÉMO ?</h2></div>
                <div class="modal-body">Toutes les lignes marquées DÉMO (articles, fournisseurs, faits, risques, utilisateurs de démo) sont supprimées. Les vraies données importées sont conservées. Cette opération est irréversible.</div>
                <div class="modal-foot"><button class="btn" @onclick="() => _confirmPurge = false">Annuler</button><button class="btn primary" @onclick="Purge">Supprimer les données de DÉMO</button></div>
            </div>
        </div>
    }
</RequirePermission>

@code {
    private static string CountLabel(string key) => key switch
    {
        "Products" => "Articles", "Suppliers" => "Fournisseurs", "Risks" => "Risques", _ => key,
    };

    private static string RunStatus(string status) => status switch
    {
        "Imported" => "Importé", "Rejected" => "Rejeté", "Failed" => "Échec", "No data" => "Aucune donnée", _ => status,
    };

    private static string BatchStatus(string status) => status switch
    {
        "Committed" => "Importé", "Validated" => "Validé", "Rejected" => "Rejeté", "Failed" => "Échec", _ => status,
    };

    private const long MaxBytes = 25 * 1024 * 1024;
    private List<ImportTemplateInfo> _templates = [];
    private List<ImportBatchDto> _history = [];
    private DataStatus? _status;
    private string _type = "";
    private ImportPreview? _preview;
    private ImportResult? _result;
    private string? _error;
    private bool _busy, _confirmPurge;

    private ImportTemplateInfo? Selected => _templates.FirstOrDefault(t => t.Type == _type);
    private string Step(int n)
    {
        var current = _result is not null ? 5 : _preview is not null ? 3 : !string.IsNullOrEmpty(_type) ? 2 : 1;
        return n < current ? "done" : n == current ? "on" : "";
    }

    private sealed class SourceForm
    {
        public string Name { get; set; } = "";
        public string Kind { get; set; } = "SqlStaging";
        public string ImportType { get; set; } = "inventory";
        public string Location { get; set; } = "";
        public string? ConnectionName { get; set; }
        public string? DailyAt { get; set; } = "06:00";
        public bool Enabled { get; set; } = true;
    }
    private List<DataSourceDto> _sources = [];
    private RefreshInfo? _info;
    private List<DataSourceRunResult> _runResults = [];
    private SourceForm? _source;
    private int? _sourceId;
    private string? _sourceError;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private void NewSource() { _sourceId = null; _sourceError = null; _source = new SourceForm(); }

    private void EditSource(DataSourceDto s)
    {
        _sourceId = s.Id; _sourceError = null;
        _source = new SourceForm { Name = s.Name, Kind = s.Kind, ImportType = s.ImportType, Location = s.Location, ConnectionName = s.ConnectionName, DailyAt = s.DailyAt, Enabled = s.Enabled };
    }

    private async Task SaveSource()
    {
        if (_source is null) return;
        _sourceError = null;
        var body = new DataSourceUpsert(_source.Name, _source.Kind, _source.ImportType, _source.Location, _source.ConnectionName, _source.DailyAt, _source.Enabled);
        try
        {
            if (_sourceId is { } id) await Api.PutAsync<DataSourceDto>($"api/data-sources/{id}", body);
            else await Api.PostAsync<DataSourceDto>("api/data-sources", body);
            _source = null;
            await LoadAsync();
        }
        catch (ApiException ex) { _sourceError = ex.Full; }
    }

    private async Task DeleteSource()
    {
        if (_sourceId is not { } id) return;
        try { await Api.SendAsync(HttpMethod.Delete, $"api/data-sources/{id}"); _source = null; await LoadAsync(); }
        catch (ApiException ex) { _sourceError = ex.Full; }
    }

    private async Task RunSource(DataSourceDto s) => await Run($"api/data-sources/{s.Id}/run");
    private async Task RunAll() => await Run("api/data-sources/run-all");

    private async Task Run(string url)
    {
        _busy = true; _error = null;
        try
        {
            _runResults = (await Api.PostAsync<List<DataSourceRunResult>>(url, new { })).ToList();
            Filters.Options = await Api.GetAsync<FilterOptions>("api/filters/options");
            await LoadAsync();
        }
        catch (ApiException ex) { _error = ex.Full; }
        finally { _busy = false; }
    }

    private async Task LoadAsync()
    {
        try
        {
            _templates = (await Api.GetAsync<List<ImportTemplateInfo>>("api/imports/templates")).ToList();
            _history = (await Api.GetAsync<List<ImportBatchDto>>("api/imports/history")).ToList();
            _status = await Api.GetAsync<DataStatus>("api/data/status");
            _sources = (await Api.GetAsync<List<DataSourceDto>>("api/data-sources")).ToList();
            _info = await Api.GetAsync<RefreshInfo>("api/data-sources/info");
        }
        catch (ApiException ex) { _error = ex.Full; }
    }

    private void ResetPreview() { _preview = null; _result = null; _error = null; }

    private async Task Upload(InputFileChangeEventArgs e)
    {
        ResetPreview();
        var file = e.File;
        if (file.Size > MaxBytes) { _error = "Le fichier dépasse 25 Mo."; return; }
        if (!file.Name.EndsWith(".xlsx", StringComparison.OrdinalIgnoreCase)) { _error = "Seuls les classeurs .xlsx sont acceptés."; return; }
        _busy = true;
        try
        {
            await using var stream = file.OpenReadStream(MaxBytes);
            using var buffer = new MemoryStream();
            await stream.CopyToAsync(buffer);
            buffer.Position = 0;
            _preview = await Api.UploadAsync<ImportPreview>($"api/imports/preview/{_type}", buffer, file.Name);
        }
        catch (ApiException ex) { _error = ex.Full; }
        catch (IOException ex) { _error = "Échec du chargement : " + ex.Message; }
        finally { _busy = false; }
    }

    private async Task Commit()
    {
        if (_preview is null) return;
        _busy = true;
        _error = null;
        try
        {
            _result = await Api.PostAsync<ImportResult>($"api/imports/{_preview.Id}/commit", new { });
            _preview = null;
            Filters.Options = null;
            Filters.Options = await Api.GetAsync<FilterOptions>("api/filters/options");
            await LoadAsync();
        }
        catch (ApiException ex) { _error = ex.Full; }
        finally { _busy = false; }
    }

    private async Task Purge()
    {
        _confirmPurge = false;
        _busy = true;
        try
        {
            await Api.SendAsync(HttpMethod.Post, "api/imports/purge-demo");
            Filters.Options = await Api.GetAsync<FilterOptions>("api/filters/options");
            await LoadAsync();
        }
        catch (ApiException ex) { _error = ex.Full; }
        finally { _busy = false; }
    }

    private async Task DownloadTemplate(string type)
    {
        try
        {
            var (content, name) = await Api.DownloadAsync($"api/imports/templates/{type}");
            using var stream = new MemoryStream(content);
            using var streamRef = new DotNetStreamReference(stream);
            await JS.InvokeVoidAsync("sop.download", name, "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet", streamRef);
        }
        catch (ApiException ex) { _error = ex.Full; }
    }
}
