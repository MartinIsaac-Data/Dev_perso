@page "/planned/{Module}"

<PageTitle>@Module · Broli S&amp;OP</PageTitle>

<PageHeader Title="@Module" Question="@Question" />
<div class="card" style="max-width:760px">
    <div class="card-body" style="padding:28px">
        <span class="badge st-neutral">Planned — Phase 3</span>
        <p style="font-size:15px">@Description</p>
        <p class="muted">Phases 1 and 2 deliver the foundation this module reuses: the data model, the coverage and ETA risk engines, filters, exports and roles.
            Meanwhile, the underlying data is available in <a href="inventory">Inventory</a>, <a href="supply">Supply</a> and <a href="risks">Risks</a> — filter by Material Type or Product Family.</p>
    </div>
</div>

@code {
    [Parameter] public string Module { get; set; } = "";

    private string Question => Module switch
    {
        "MRP" => "What must we order, how much and when?",
        "Raw Materials" => "Which raw material needs action?",
        "Finished Goods" => "Can we serve demand for each pasta family?",
        "Films" => "Which films are short, late or slow moving?",
        "Transit" => "Where is every container, and when will it be in our warehouse?",
        "Suppliers" => "Which supplier is late most often?",
        "S&OP Actions" => "Who does what by when after the S&OP meeting?",
        _ => "",
    };

    private string Description => Module switch
    {
        "MRP" => "Net requirements per CArtSAP over M+1…M+4: opening stock, forecast, open orders, transit, projected stock, net requirement and recommended order quantity rounded to TC.",
        "Raw Materials" => "Material, supplier, country, stock, consumption, coverage, open PO, transit, ETA, cost and value, with KG → TC conversion from configuration.",
        "Finished Goods" => "Stock, forecast, actual, production, sales, coverage and service level for Spaghetti, Macaroni, Short Pasta and the Mayonnaise project.",
        "Films" => "Brand, format, colour and supplier view of plastic films with automatic slow-moving, excess, shortage, stockout-risk and late-supply flags.",
        "Transit" => "PO, booking, BL, ETD, ETA, actual arrival, customs and clearing, estimated delivery and configurable transit times by country and supplier.",
        "Suppliers" => "On-time delivery, average delay, open orders, in transit, quality issues and average transit time per supplier.",
        "S&OP Actions" => "Action tracker with owner, department, due date, priority and status, editable by authorised users, plus the one-page S&OP meeting view.",
        _ => "This module is planned for a later phase.",
    };
}
