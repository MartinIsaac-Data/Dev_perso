@page "/supply"
@inherits SopPage

<PageTitle>Approvisionnement · Broli S&amp;OP</PageTitle>

<RequirePermission Permission="@Permissions.SupplyView">
    <PageHeader Title="Approvisionnement et commandes ouvertes" Question="Quelles commandes sont en retard, et lesquelles arrivent après la rupture ?" Period="_d?.Period">
        <Actions><ExportMenu Dataset="supply" Query="_q" /></Actions>
    </PageHeader>

    <LoadState HasData="_d is not null" Error="@Error" OnRetry="ReloadAsync">
        @if (_d is { } d)
        {
            var s = d.Summary;
            <div class="kpis">
                @Tile("Commandes ouvertes", s.OpenLines.ToString("N0"), "lignes", $"{Fmt.Num(s.OpenTc, 1)} TC en commande", "neutral", "open")
                @Tile("TC en transit", Fmt.Num(s.InTransitTc, 1), "TC", "Expédiés, au port ou en douane", "neutral", "transit")
                @Tile("TC au port", Fmt.Num(s.AtPortTc, 1), "TC", "Au port ou en dédouanement", s.AtPortTc > 0 ? "watch" : "neutral", "port")
                @Tile("Commandes en retard", s.LateLines.ToString("N0"), "lignes", $"{s.CriticalLines} arrivent après la rupture prévue", s.CriticalLines > 0 ? "bad" : s.LateLines > 0 ? "watch" : "good", "late")
                @Tile("OTIF", Fmt.Pct(s.OtifPct), null, $"Livraisons de la période · retard moyen {Fmt.Num(s.AvgDelayDays, 1)} j · transit {Fmt.Num(s.AvgTransitDays, 0)} j", "neutral", "delivered")
            </div>

            <div class="grid g-3 mb">
                <div class="card">
                    <div class="card-head"><h2>Arrivées — 12 prochaines semaines</h2><span class="hint">TC par semaine d'ETA</span></div>
                    <div class="card-body">
                        <SopChart Type="bar" Height="240" Labels="d.ArrivalsByWeekTc.Select(p => p.Label).ToList()" Unit="TC" AriaLabel="Conteneurs attendus par semaine"
                                  Datasets="@([new ChartDataset("Arrivées", d.ArrivalsByWeekTc.Select(p => p.Value).ToList(), "--series-1",
                                              PointColors: d.ArrivalsByWeekTc.Select(p => p.Key == "overdue" ? "--serious" : "--series-1").ToList())])" />
                    </div>
                </div>
                <div class="card">
                    <div class="card-head"><h2>Lignes ouvertes par statut</h2><span class="hint">Lignes de commande</span></div>
                    <div class="card-body">
                        <SopChart Type="bar" Horizontal="true" Height="240" Labels="d.ByStatus.Select(p => p.Label).ToList()" Unit="lignes" AriaLabel="Lignes ouvertes par statut"
                                  Datasets="@([new ChartDataset("Lignes", d.ByStatus.Select(p => p.Value).ToList(), "--series-1")])"
                                  OnClick="c => FilterStatus(d.ByStatus[c.Index].Key)" />
                    </div>
                </div>
                <div class="card">
                    <div class="card-head"><h2>Risque ETA</h2><span class="hint">lignes ouvertes · cliquer pour la liste</span></div>
                    <div class="card-body">
                        <SopChart Type="bar" Height="240" Labels="d.RiskLevels.Select(p => p.Label).ToList()" Unit="lignes" AriaLabel="Lignes ouvertes par niveau de risque ETA"
                                  Datasets="@([new ChartDataset("Lignes", d.RiskLevels.Select(p => p.Value).ToList(), "--series-1",
                                              PointColors: d.RiskLevels.Select(p => StatusColors.For(p.Label)).ToList())])"
                                  OnClick="c => SetView(RiskView(d.RiskLevels[c.Index].Key))" />
                    </div>
                </div>
            </div>

            <div class="card">
                <ViewTabs Current="@(_q.View ?? "open")" OnSelect="SetView"
                          Items="@([("open", "Ouvertes"), ("late", "En retard"), ("critical", "Critiques"), ("watch", "À surveiller"), ("transit", "En transit"), ("port", "Au port / en douane"), ("delivered", "Livrées sur la période"), ("all", "Toutes")])" />
                <div class="table-tools">
                    <input type="search" placeholder="Rechercher commande, CArtSAP, article, fournisseur, BL…" @bind="_q.Search" @bind:event="oninput" @bind:after="SearchChanged" />
                    <span class="muted">Risque : ETA après la rupture prévue = Critique · après la date de besoin = Risque appro · dans la fenêtre de sécurité = À surveiller.</span>
                </div>
                <div class="table-wrap">
                    <table class="data dense">
                        <thead>
                            <tr>
                                <Th Query="_q" Field="PoNumber" OnChanged="LoadRows">Commande</Th>
                                <Th Query="_q" Field="Product" OnChanged="LoadRows">Article</Th>
                                <Th Query="_q" Field="Supplier" OnChanged="LoadRows">Fournisseur</Th>
                                <Th Query="_q" Field="Quantity" Numeric OnChanged="LoadRows">Quantité</Th>
                                <Th Query="_q" Field="Tc" Numeric OnChanged="LoadRows">TC</Th>
                                <Th Query="_q" Field="Etd" OnChanged="LoadRows">ETD</Th>
                                <Th Query="_q" Field="Eta" OnChanged="LoadRows">ETA</Th>
                                <Th Query="_q" Field="RequiredDate" OnChanged="LoadRows">Besoin</Th>
                                <Th Query="_q" Field="Status" OnChanged="LoadRows">Statut</Th>
                                <Th Query="_q" Field="DelayDays" Numeric OnChanged="LoadRows">Retard</Th>
                                <Th Query="_q" Field="Risk" OnChanged="LoadRows">Risque</Th>
                                @if (_canEdit) { <th></th> }
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var r in _rows?.Items ?? [])
                            {
                                <tr class="click" @onclick="@(() => Go($"products/{Uri.EscapeDataString(r.CArtSap)}"))">
                                    <td class="code">@r.PoNumber<span class="sub">@Fmt.Date(r.OrderDate)</span></td>
                                    <td><b>@r.Product</b><span class="sub">@r.CArtSap · @r.Category</span></td>
                                    <td>@r.Supplier<span class="sub">@r.Country @(r.Port is null ? "" : "→ " + r.Port)</span></td>
                                    <td class="num">@Fmt.Num(r.Quantity) <span class="muted">@r.Unit</span></td>
                                    <td class="num">@Fmt.Num(r.Tc, 1)</td>
                                    <td class="nowrap">@Fmt.Date(r.Etd)</td>
                                    <td class="nowrap"><b>@Fmt.Date(r.ActualArrival ?? r.Eta)</b>@if (r.ActualArrival is not null) {<span class="sub">arrivée</span>}</td>
                                    <td class="nowrap">@Fmt.Date(r.RequiredDate)</td>
                                    <td><span class="badge st-neutral">@r.Status</span>@if (r.CustomsStatus is not null) {<span class="sub">@r.CustomsStatus</span>}</td>
                                    <td class="num">@(r.DelayDays is > 0 ? $"{r.DelayDays} j" : Fmt.Empty)</td>
                                    <td><StatusBadge Status="@r.RiskLevel" />@if (r.RiskReason is not null) {<span class="sub">@r.RiskReason</span>}</td>
                                    @if (_canEdit) { <td><button class="btn sm" @onclick="() => Edit(r)" @onclick:stopPropagation>Modifier</button></td> }
                                </tr>
                            }
                        </tbody>
                    </table>
                    @if (_rows is { Total: 0 }) { <div class="empty">Aucune ligne d'approvisionnement ne correspond à cette vue et à ces filtres.</div> }
                </div>
                <Pager Query="_q" Total="@(_rows?.Total ?? 0)" OnChanged="LoadRows" />
            </div>
        }
    </LoadState>

    @if (_edit is not null)
    {
        <div class="modal-back" @onclick="() => _edit = null">
            <div class="modal" @onclick:stopPropagation role="dialog" aria-modal="true" aria-label="Modifier la ligne d'approvisionnement">
                <div class="modal-head"><h2>Modifier la commande @_edit.PoNumber — @_edit.Product</h2><button class="icon-btn" @onclick="() => _edit = null">✕</button></div>
                <div class="modal-body">
                    @if (_editError is not null) { <div class="alert error">@_editError</div> }
                    <div class="form">
                        <div class="field"><label>ETD</label><input type="date" @bind="_etd" /></div>
                        <div class="field"><label>ETA</label><input type="date" @bind="_eta" /></div>
                        <div class="field"><label>Statut</label>
                            <select @bind="_status">@foreach (var o in Filters.Options?.Statuses ?? []) { <option value="@o.Value">@o.Label</option> }</select>
                        </div>
                        <div class="field"><label>Arrivée réelle</label><input type="date" @bind="_arrival" /><div class="help">Obligatoire si le statut est Livré.</div></div>
                        <div class="field full"><label>Statut douane</label><input @bind="_customs" maxlength="200" /></div>
                    </div>
                    <p class="muted" style="margin-bottom:0">Chaque modification est enregistrée dans le journal d'audit (utilisateur, date, ancienne et nouvelle valeur).</p>
                </div>
                <div class="modal-foot">
                    <button class="btn" @onclick="() => _edit = null">Annuler</button>
                    <button class="btn primary" @onclick="SaveEdit" disabled="@_saving">Enregistrer</button>
                </div>
            </div>
        </div>
    }
</RequirePermission>

@code {
    [SupplyParameterFromQuery(Name = "view")] public string? View { get; set; }
    [SupplyParameterFromQuery(Name = "search")] public string? SearchParam { get; set; }

    private SupplyDashboard? _d;
    private PagedResult<SupplyRow>? _rows;
    private readonly TableQuery _q = new();
    private bool _canEdit => Session.Can(Permissions.SupplyEdit);

    private SupplyRow? _edit;
    private DateOnly? _etd, _eta, _arrival;
    private string? _status, _customs, _editError;
    private bool _saving;

    protected override async Task LoadAsync(CancellationToken ct)
    {
        if (_q.View != View) _q.Sort = null;
        _q.View = View ?? "open";
        if (SearchParam is not null && _q.Search is null) _q.Search = SearchParam;
        _q.Page = 1;
        var dash = Api.GetAsync<SupplyDashboard>("api/supply", Filter, ct: ct);
        var rows = Api.GetAsync<PagedResult<SupplyRow>>("api/supply/rows", Filter, _q, ct);
        _d = await dash;
        _rows = await rows;
    }

    private async Task LoadRows()
    {
        try { _rows = await Api.GetAsync<PagedResult<SupplyRow>>("api/supply/rows", Filter, _q); }
        catch (ApiException ex) { Console.Error.WriteLine(ex.Message); }
    }

    private Task SearchChanged() { _q.Page = 1; return LoadRows(); }
    private void SetView(string v) => Go($"supply?view={v}");
    private static string RiskView(string? key) => key switch { "Critical" => "critical", "SupplyRisk" => "late", "Watch" => "watch", _ => "open" };
    private Task FilterStatus(string? status) => status is null ? Task.CompletedTask : Filters.UpdateAsync(f => f.Statuses = [status]);

    private void Edit(SupplyRow r)
    {
        _edit = r;
        _etd = r.Etd; _eta = r.Eta; _arrival = r.ActualArrival; _customs = r.CustomsStatus;
        _status = Filters.Options?.Statuses.FirstOrDefault(o => o.Label == r.Status)?.Value ?? r.Status.Replace(" ", "");
        _editError = null;
    }

    private async Task SaveEdit()
    {
        if (_edit is null) return;
        _saving = true;
        _editError = null;
        try
        {
            await Api.SendAsync(HttpMethod.Put, $"api/supply/{_edit.Id}", new SupplyUpdateRequest(_etd, _eta, _arrival, _status, _customs));
            _edit = null;
            await ReloadAsync();
        }
        catch (ApiException ex) { _editError = ex.Full; }
        finally { _saving = false; }
    }

    private RenderFragment Tile(string title, string value, string? unit, string sub, string status, string view) => __builder =>
    {
        <button type="button" class="kpi @status" @onclick="() => SetView(view)">
            <div class="k-title"><span>@title</span><span class="go">›</span></div>
            <div class="k-value">@value@if (unit is not null) {<span class="u">@unit</span>}</div>
            <div class="k-sub">@sub</div>
        </button>
    };
}
