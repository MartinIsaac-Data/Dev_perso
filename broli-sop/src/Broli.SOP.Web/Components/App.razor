<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <title>Broli S&amp;OP Portal</title>
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='7' fill='%230f2a47'/%3E%3Cpath d='M8 22l5-6 4 3 7-9' stroke='%233c8ce7' stroke-width='3' fill='none' stroke-linecap='round'/%3E%3C/svg%3E" />
    <ResourcePreloader />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <ImportMap />
    <HeadOutlet @rendermode="RenderModeServer" />
</head>
<body>
    <Routes @rendermode="RenderModeServer" ClientIp="@HttpContext?.Connection.RemoteIpAddress?.ToString()" />
    <ReconnectModal />
    <div id="blazor-error-ui" data-nosnippet>
        An unexpected error occurred. <a href="" class="reload">Reload</a>
        <span class="dismiss">✕</span>
    </div>
    <script src="lib/chartjs/chart.umd.min.js"></script>
    <script src="@Assets["js/app.js"]"></script>
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>
</html>

@code {
    // Rendered during the page request, the only moment the browser's address is known; it reaches the circuit as a
    // server-protected component parameter (the browser cannot alter it) and is forwarded to the API from there.
    [CascadingParameter] private HttpContext? HttpContext { get; set; }

    // No prerendering: the session lives in protected browser storage, which is only readable once interactive.
    private static readonly IComponentRenderMode RenderModeServer = new InteractiveServerRenderMode(prerender: false);
}
