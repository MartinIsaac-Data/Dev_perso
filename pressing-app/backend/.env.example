# PostgreSQL connection used by Prisma
DATABASE_URL="postgresql://pressing:pressing@localhost:5432/pressing_db"

# JWT
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="8h"

# Server
PORT=4000
CORS_ORIGIN="http://localhost:5173"

# Order item photos — local disk storage (see src/services/storageService.ts).
# Note: on Render's free/starter plans the filesystem is ephemeral and wiped
# on every deploy — fine for demoing, not for production; swap storageService
# for an S3-compatible bucket before relying on this for real customer data.
# UPLOAD_DIR="./uploads"

# Business defaults (also editable at runtime via /api/settings)
DEFAULT_CURRENCY="FCFA"

# Notification providers — leave unset to use the LogProvider (writes to DB + console only)
# SMS_PROVIDER=twilio
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
# Resend (resend.com) — transactional email
# RESEND_API_KEY=
# RESEND_FROM_EMAIL="Pressing Étoile <no-reply@your-verified-domain.com>"
# WHATSAPP_PROVIDER=whatsapp_business
# WHATSAPP_BUSINESS_TOKEN=
# WHATSAPP_PHONE_ID=

# Mobile money — leave unset to use the simulated provider (fake instant
# success, no real money moved). Also overridable live from Settings
# ("Mode simulation" toggle) without redeploying. See src/services/
# mobileMoneyProviders.ts for exactly what each integration does.

# MTN Mobile Money — Collections API (momodeveloper.mtn.com)
# MTN_MOMO_SUBSCRIPTION_KEY=
# MTN_MOMO_API_USER=
# MTN_MOMO_API_KEY=
# MTN_MOMO_TARGET_ENVIRONMENT=sandbox
# MTN_MOMO_BASE_URL=https://sandbox.momodeveloper.mtn.com
# MTN_MOMO_WEBHOOK_SECRET=

# Orange Money — Web Payment API (developer.orange.com)
# ORANGE_MONEY_CLIENT_ID=
# ORANGE_MONEY_CLIENT_SECRET=
# ORANGE_MONEY_MERCHANT_KEY=
# ORANGE_MONEY_COUNTRY_CODE=cm
# ORANGE_MONEY_BASE_URL=https://api.orange.com
# ORANGE_MONEY_RETURN_URL=https://your-frontend.example.com/payment/return
# ORANGE_MONEY_NOTIF_URL=https://your-backend.example.com/api/webhooks/orange-money
# ORANGE_MONEY_WEBHOOK_SECRET=
