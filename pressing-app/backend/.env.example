# PostgreSQL connection used by Prisma
DATABASE_URL="postgresql://pressing:pressing@localhost:5432/pressing_db"

# JWT
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="8h"

# Server
PORT=4000
CORS_ORIGIN="http://localhost:5173"

# Business defaults (also editable at runtime via /api/settings)
DEFAULT_CURRENCY="FCFA"

# Notification providers — leave unset to use the LogProvider (writes to DB + console only)
# SMS_PROVIDER=twilio
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
# EMAIL_PROVIDER=smtp
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASSWORD=
# WHATSAPP_PROVIDER=whatsapp_business
# WHATSAPP_BUSINESS_TOKEN=
# WHATSAPP_PHONE_ID=
