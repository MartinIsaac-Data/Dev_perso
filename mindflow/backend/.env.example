# Copy to .env for local development. Every value below is a safe default;
# the application refuses to start in staging/prod with a fake AI backend or a
# missing token-verification method (app/config.py).

MINDFLOW_ENV=local
MINDFLOW_LOG_FORMAT=console
MINDFLOW_LOG_LEVEL=info

MINDFLOW_DATABASE_URL=postgresql+asyncpg://mindflow:mindflow@localhost:5432/mindflow
MINDFLOW_REDIS_URL=redis://localhost:6379/0

# -- Supabase (ADR-029, ADR-030) -------------------------------------------
# Leave empty locally: unsigned development tokens are accepted in local/test
# only, and refused everywhere else.
MINDFLOW_SUPABASE_URL=
MINDFLOW_SUPABASE_JWT_SECRET=
MINDFLOW_SUPABASE_JWKS_URL=
MINDFLOW_SUPABASE_SERVICE_KEY=

MINDFLOW_STORAGE_BACKEND=local
MINDFLOW_STORAGE_BUCKET=captures
MINDFLOW_STORAGE_LOCAL_ROOT=/var/lib/mindflow/objects

# -- AI (ADR-007, ADR-031) --------------------------------------------------
# fake = deterministic, no network. Switch to openai/faster_whisper with a key.
MINDFLOW_STT_BACKEND=fake
MINDFLOW_LLM_BACKEND=fake
MINDFLOW_LLM_MODEL=gpt-4o-mini
MINDFLOW_OPENAI_API_KEY=
MINDFLOW_ANTHROPIC_API_KEY=

# inline runs the pipeline in-process; arq hands it to the worker.
MINDFLOW_QUEUE_BACKEND=arq
