# PostgreSQL connection string (Neon, Supabase, RDS, local Postgres — anything works)
DATABASE_URL="postgresql://user:password@host:5432/mba_compass?sslmode=require"

# Auth.js — generate with: npx auth secret
AUTH_SECRET="replace-with-a-random-32-byte-secret"
NEXTAUTH_URL="http://localhost:3000"

# AI Advisor — optional. Leave AI_PROVIDER empty to run the app without AI features.
# AI_PROVIDER is either "openai" or "anthropic".
AI_PROVIDER=""
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
# Optional: override the default model for whichever provider is active.
OPENAI_MODEL=""
ANTHROPIC_MODEL=""
