# Copy to .env and adjust. Every variable is prefixed TOS_ and read through
# app/config.py; no module reads os.environ directly.

# --- Storage ---------------------------------------------------------------
# Default: SQLite in ./data. Switch to Postgres by changing this line alone —
# the schema contains nothing SQLite-specific.
# TOS_DATABASE_URL=sqlite+pysqlite:///./data/transformation_os.db
# TOS_DATABASE_URL=postgresql+psycopg://tos:tos@localhost:5432/tos

# Echo every SQL statement to stderr. Worth switching on while learning what
# SQLAlchemy actually emits; unbearable otherwise.
# TOS_SQL_ECHO=false

# --- Agents (Phase 3) ------------------------------------------------------
# Without a key the agent endpoints report themselves as unconfigured rather
# than failing at call time. Everything else works.
# TOS_ANTHROPIC_API_KEY=sk-ant-...
# TOS_ANTHROPIC_MODEL=claude-sonnet-5

# --- Business rules --------------------------------------------------------
# Fallback decay window for skills that do not declare their own.
# TOS_DEFAULT_SKILL_DECAY_MONTHS=9
