# ---------------------------------------------------------------------------
#  Configuration — toute variable lue par spp.common.config est documentée ici.
#  Aucun secret n'est versionné.
# ---------------------------------------------------------------------------

SPP_ENV=local                  # local | ci | staging | production
SPP_LOG_LEVEL=INFO
SPP_LOG_FORMAT=console         # console (lisible) | json (production)

# Base de données
SPP_DATABASE_URL=postgresql+psycopg://spp:spp@localhost:5433/spp
SPP_DATABASE_POOL_SIZE=5

# Cache
SPP_REDIS_URL=redis://localhost:6380/0

# API
SPP_API_HOST=0.0.0.0
SPP_API_PORT=8000
SPP_API_CORS_ORIGINS=http://localhost:3000

# Fournisseurs de données (aucune valeur par défaut : absence = source désactivée)
SPP_ODDS_API_KEY=
SPP_STATS_API_KEY=
SPP_WEATHER_API_BASE=https://api.open-meteo.com/v1

# Garde-fous de valorisation — voir docs/06
SPP_EDGE_THRESHOLD=0.02
SPP_UNCERTAINTY_K=1.0
SPP_KELLY_FRACTION=0.25
SPP_MAX_STAKE_PCT=0.02
SPP_MIN_DATA_QUALITY=0.75
