# Secrets and local configuration
.env

# Local database — the schema is versioned, the data is not.
data/
*.db
*.db-journal
*.sqlite3

# Generated analytical exports
exports/*
!exports/.gitkeep

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Front end (Phase 1)
node_modules/
dist/
.vite/

# Flutter.
#
# `android/` and `ios/` stay ignored: nothing in this project has customised
# them, so they are still tool output that `flutter create` reproduces exactly.
#
# `web/`, `linux/`, `macos/` and `windows/` are committed as of phase 4
# (ADR-060). They stopped being tool output the moment they carried the window
# title, the initial window size and the web boot screen — a generated file you
# have to hand-edit after generating it is source, and regenerating it silently
# reverts those edits.
mindflow/frontend/.dart_tool/
mindflow/frontend/build/
mindflow/frontend/.flutter-plugins
mindflow/frontend/.flutter-plugins-dependencies
mindflow/frontend/.packages
mindflow/frontend/android/
mindflow/frontend/ios/
mindflow/frontend/coverage/
mindflow/frontend/*.iml
mindflow/frontend/linux/flutter/ephemeral/
mindflow/frontend/macos/Flutter/ephemeral/
mindflow/frontend/windows/flutter/ephemeral/

# Editors and OS
.DS_Store
.idea/
.vscode/
*.swp

# TypeScript incremental build cache
*.tsbuildinfo
